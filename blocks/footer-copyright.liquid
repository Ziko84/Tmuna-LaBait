
{% assign block_settings = block.settings %}
<div
  class="
    footer-utilities__group-copyright
    custom-typography
    {% if block_settings.font_size != "" %}custom-font-size{% endif %}
  "
  style="
    {% render 'typography-style', preset: 'custom', settings: block_settings %}
    {% if block_settings.text_color != blank %}--color-utilities: {{ block_settings.text_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  <span class="footer-utilities__text">
    &copy; {{ 'now' | date: '%Y' }}
    {{ shop.name | link_to: routes.root_url -}}
    {%- if block_settings.show_powered_by -%}
      , {{ powered_by_link }}
    {%- endif -%}
  </span>

  {%- comment -%}
    Business identity in the footer. Google's Misrepresentation policy expects
    the trading entity and how to reach it to be accessible from anywhere on
    the site, not only from inside a policy page.
  {%- endcomment -%}
  {%- if block_settings.business_legal_name != blank
      or block_settings.business_address != blank
      or block_settings.business_phone != blank
      or block_settings.business_email != blank
  -%}
    <span class="footer-utilities__business">
      {%- if block_settings.business_legal_name != blank -%}
        <span class="footer-utilities__business-item">
          {{- block_settings.business_legal_name -}}
          {%- if block_settings.business_company_id != blank -%}
            , {{ block_settings.business_company_id }}
          {%- endif -%}
        </span>
      {%- endif -%}
      {%- if block_settings.business_address != blank -%}
        <span class="footer-utilities__business-item">{{ block_settings.business_address }}</span>
      {%- endif -%}
      {%- if block_settings.business_phone != blank -%}
        <span class="footer-utilities__business-item">
          <a href="tel:{{ block_settings.business_phone | remove: '-' | remove: ' ' }}" dir="ltr">
            {{- block_settings.business_phone -}}
          </a>
        </span>
      {%- endif -%}
      {%- if block_settings.business_email != blank -%}
        <span class="footer-utilities__business-item">
          <a href="mailto:{{ block_settings.business_email }}" dir="ltr">
            {{- block_settings.business_email -}}
          </a>
        </span>
      {%- endif -%}
    </span>
  {%- endif -%}
</div>

{% stylesheet %}
  .footer-utilities__group-copyright {
    color: var(--color-utilities, var(--color-foreground-muted));
  }

  .footer-utilities__business {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: inherit;
    gap: 0.25rem 0.75rem;
    margin-block-start: 0.35rem;
    opacity: 0.85;
  }

  .footer-utilities__business-item + .footer-utilities__business-item::before {
    content: '·';
    margin-inline-end: 0.75rem;
    opacity: 0.6;
  }

  .footer-utilities__business a {
    color: inherit;
    text-decoration: none;
  }

  .footer-utilities__business a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.copyright",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "t:settings.show_powered_by_shopify",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "t:content.manage_store_name"
    },
    {
      "type": "header",
      "content": "Business identity"
    },
    {
      "type": "paragraph",
      "content": "Shown under the copyright line. Google requires the trading entity and contact details to be accessible site-wide."
    },
    {
      "type": "text",
      "id": "business_legal_name",
      "label": "Legal business name",
      "default": "דניאל פיקס"
    },
    {
      "type": "text",
      "id": "business_company_id",
      "label": "Company / VAT number",
      "default": "ח.פ. 306082793"
    },
    {
      "type": "text",
      "id": "business_address",
      "label": "Address",
      "default": "דרך הרימונים 28, מושב רינתיה, 7316500, ישראל"
    },
    {
      "type": "text",
      "id": "business_phone",
      "label": "Phone",
      "default": "054-638-5242"
    },
    {
      "type": "text",
      "id": "business_email",
      "label": "Email",
      "default": "info@tmuna-labait.com"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        }
      ],
      "default": "0.75rem"
    },
    {
      "type": "select",
      "id": "case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:names.copyright",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
