
{% if shop.policies.size > 0 %}
  <ul
    class="
      policy_list_inline list-unstyled
      custom-typography
      {% if block.settings.font_size != "" %}custom-font-size{% endif %}
    "
    style="
      {% render 'typography-style', preset: 'custom', settings: block.settings %}
      {% if block.settings.text_color != blank %}--color-utilities: {{ block.settings.text_color }};{% endif %}
    "
    {{ block.shopify_attributes }}
  >
    {%- comment -%}
      Two policy records are deliberately hidden here:

      - contact-information: duplicates /pages/contact, which is the real
        contact page and the only one with a working form.
      - legal-notice: word-for-word the same text as the terms of service.

      Both still exist as policy records (Shopify links them from checkout);
      they are just not listed twice in the footer.
    {%- endcomment -%}
    {%- for policy in shop.policies -%}
      {%- liquid
        assign policy_hidden = false
        if policy.url contains 'contact-information' or policy.url contains 'legal-notice'
          assign policy_hidden = true
        endif
      -%}
      {%- if policy != blank and policy_hidden == false -%}
        <li>
          <a
            href="{{ policy.url }}"
            class="footer-utilities__text"
          >
            {{- policy.title | escape -}}
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{% endif %}

{% stylesheet %}
  .policy_list_inline {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 0;
    padding: 0;
  }

  .policy_list_inline a {
    color: var(--color-foreground);
    font-size: var(--font-size, 0.75rem);
    text-transform: var(--text-transform, none);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .policy_list_inline a:hover {
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.policy_list",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.manage_policies"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        }
      ],
      "default": "0.75rem"
    },
    {
      "type": "select",
      "id": "case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:names.policy_list",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
