    {{ content_for_header }}

    <style>
      /* Product page: the whole top section (image, title, price, variant picker,
         buy buttons, trust bar, description, accordion) as ONE unified card.
         Deliberately placed after content_for_header — Shopify's own per-section/component
         CSS is injected there, landing after the main style block above and beating any
         !important set earlier via source-order tie-breaking. This block must stay last. */
      [data-template='product'] .product-information__grid {
        background: #f7f5f2 !important;
        border-radius: 32px !important;
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.1), 0 2px 6px rgba(0, 0, 0, 0.06) !important;
        padding: 32px !important;
        margin-inline: auto !important;
        align-items: stretch !important;
      }
      /* max-width:85% here was unconditional, only ever undone by the
         max-width:100% further down scoped to <=749px. Tablet widths
         (roughly 750-989px) got neither: 85% of an already-narrow tablet
         viewport, combined with the native grid's sidebar-width-based
         column math, squeezed the image column down to a sliver (~24px -
         effectively invisible) since the details column claims a near-
         fixed width first and the image only gets whatever's left over.
         Only apply the narrower card width once the viewport is wide
         enough (matching this theme's own desktop breakpoint) that 85%
         still leaves the image a real column. */
      @media screen and (min-width: 990px) {
        [data-template='product'] .product-information__grid {
          max-width: 85% !important;
        }
      }
      /* Even with the 85% cap gone below 990px, the grid was still only
         claiming part of its own column track (subgrid sizing to some
         intrinsic width instead of the full track) - explicit 100% forces
         it to actually fill the space it has, which is what gives the
         image column room to exist instead of collapsing to a sliver. */
      @media screen and (max-width: 989px) {
        [data-template='product'] .product-information__grid {
          width: 100% !important;
        }
      }

      @media screen and (min-width: 750px) {
        /* Native theme CSS (.product-details product-price > * { text-align:
           left }) has slightly higher specificity than the .text-right
           utility class the price block's own alignment setting relies on,
           so it was silently winning over the "align right" choice made in
           the theme editor - force it here instead. */
        [data-template='product'] .product-details product-price,
        [data-template='product'] .product-details product-price > * {
          text-align: right !important;
        }
        [data-template='product'] .product-details product-price {
          font-size: 1.125rem !important;
        }
        [data-template='product'] .product-information__media {
          /* Sized by the image's own 1:1 ratio, not by the details column.
             Stretching to the column made the frame grow whenever an
             accordion opened, letterboxing the square photo. */
          height: auto !important;
          align-self: start !important;
          display: flex !important;
        }
        [data-template='product'] .product-information__media media-gallery {
          display: flex !important;
          flex-direction: column !important;
          width: 100% !important;
        }
        /* The gallery web component nests slideshow-component > slideshow-container >
           slideshow-slides > .product-media-container (slideshow-slide) before reaching
           the image. Each of those has to be told to fill height too, or the stretch
           stops at whichever level is still sized to its content. */
        [data-template='product'] .product-information__media slideshow-component {
          flex: 1 1 auto !important;
          min-height: 0 !important;
        }
        [data-template='product'] .product-information__media slideshow-container,
        [data-template='product'] .product-information__media slideshow-slides {
          height: 100% !important;
        }
        [data-template='product'] .product-information__media .product-media-container {
          /* Theme's base.css sets aspect-ratio + a max-height capped to ~viewport
             height on .constrain-height; both override a plain height:100%, so they
             have to be neutralized explicitly for the image to actually reach the
             card's full height instead of stopping early. */
          aspect-ratio: 1 / 1 !important;
          max-height: none !important;
          height: auto !important;
          /* NOT flex: 1 - the native rule for this element is
             width: var(--slide-width, 100%), each slide taking the full row
             width with horizontal scroll-snap between them. flex: 1 sets
             flex-basis: 0%, which overrides that width entirely - with 2
             slides in the row they'd each just grow to fill half the
             available space, rendering side by side instead of full-width
             with one visible at a time. Height still stretches fine without
             it (cross-axis stretch doesn't need flex-grow on the main axis). */
          width: 100% !important;
          min-height: 0 !important;
        }
        [data-template='product'] .product-information__media img.product-media__image {
          width: 100% !important;
          height: 100% !important;
          object-fit: cover !important;
          transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        /* Subtle zoom on hover so the wood grain and laser-cut detail read
           as tangible, not just a flat photo. .product-media-container
           already clips overflow, so this can't spill past the rounded
           corners. */
        [data-template='product'] .product-information__media .product-media-container:hover img.product-media__image {
          transform: scale(1.04) !important;
        }
        /* Left-side thumbnail rail: the theme stretches slideshow-controls to the
           full image height via the gallery's grid, but its own
           slideshow-controls__thumbnails-container only sizes to its (few)
           thumbnails and the outer flex box defaults to justify-content:
           space-between, which shoves that short stack to the top and leaves
           the rest of the tall rail empty. Center it instead so a handful of
           thumbnails read as a deliberate rail, not a layout accident. */
        [data-template='product'] .product-information__media slideshow-controls[pagination-position='left'] {
          justify-content: center !important;
          gap: 14px !important;
        }
        /* RTL grid-template swap: the native grid-template for
           pagination-position="left"/"right" names its first track/area at
           the layout's inline-start edge, which under this document's
           dir="rtl" is the physical RIGHT, not the left the setting name
           implies (and vice versa for "right") - so "left" was rendering
           the thumbnail rail on the physical right. Swapping which
           template string each value uses puts the rail back on the side
           the setting actually says. */
        .media-gallery--carousel slideshow-component:has(slideshow-controls[thumbnails]):has(slideshow-controls[pagination-position='left']) {
          grid-template:
            'container controls' auto
            'arrows controls' min-content
            / 1fr auto !important;
          gap: 16px !important;
        }
        .media-gallery--carousel slideshow-component:has(slideshow-controls[thumbnails]):has(slideshow-controls[pagination-position='right']) {
          grid-template:
            'controls container' auto
            'controls arrows' min-content
            / auto 1fr !important;
          gap: 16px !important;
        }
      }
      @media screen and (max-width: 749px) {
        [data-template='product'] .product-information__grid {
          border-radius: 20px !important;
          padding: 16px !important;
          max-width: 100% !important;
        }
        [data-template='product'] .product-details {
          margin-top: 40px !important;
        }
        /* Pulls the Add to Cart row closer to the variant picker above it -
           the group's own block gap read as too much empty space directly
           over the button. */
        [data-template='product'] .product-form-buttons {
          margin-top: -8px !important;
        }
        [data-template='product'] .product-form-buttons .add-to-cart-button {
          padding-block: 24px !important;
          padding-inline: 31px !important;
          font-size: 1.32rem !important;
        }
        /* Title up one more size step, price down one size step. */
        [data-template='product'] .product-details h1 {
          font-size: 4.1rem !important;
        }
        [data-template='product'] .product-details product-price {
          font-size: 1.7rem !important;
        }
        /* The PayPal/accelerated-checkout button sat right in the same
           tight gap as the rest of the row's controls, with nothing of
           its own setting it apart - gave it real breathing room above
           and below instead. */
        [data-template='product'] .product-form-buttons > .accelerated-checkout-block {
          margin-block: 14px 8px !important;
        }
      }

      /* Add to Cart above the quantity stepper on the product page. Reordering
         the content_for calls in blocks/buy-buttons.liquid alone wasn't
         reliably reflected in the rendered markup, so this pins the visual
         order directly on the flex row instead - guaranteed to apply
         regardless of DOM source order. */
      [data-template='product'] .product-form-buttons {
        display: flex !important;
      }
      [data-template='product'] .product-form-buttons > .product-form-text__error {
        order: 0;
      }
      [data-template='product'] .product-form-buttons > span:has(.add-to-cart-button) {
        order: 1;
      }
      [data-template='product'] .product-form-buttons > .quantity-label {
        order: 2;
      }
      [data-template='product'] .product-form-buttons > .quantity-selector-wrapper {
        order: 3;
      }
      [data-template='product'] .product-form-buttons > .quantity-rules {
        order: 4;
      }
      [data-template='product'] .product-form-buttons > .volume-pricing {
        order: 5;
      }
      [data-template='product'] .product-form-buttons > .accelerated-checkout-block {
        order: 6;
      }

      /* "More payment options" link under the PayPal button: it's rendered
         by Shopify's own accelerated-checkout web component, not theme
         text, so it can't be translated from here - it shows in English
         regardless of the storefront's language. Hidden since there's no
         way to make it match the rest of the (Hebrew) page. */
      .shopify-payment-button__more-options {
        display: none !important;
      }

      /* Drop shadow on the product page's main photo. Can't live on
         .product-media-container/.product-media/slideshow-slide - all
         three sit inside slideshow-slides, which has an unconditional
         overflow-x: scroll (snippets/slideshow-styles.liquid) for the
         swipe mechanic; setting one axis to scroll forces the other to
         clip too, so any shadow declared in there is cut off no matter
         what. slideshow-container (its parent) has no overflow set at
         all, and is scoped to just the "container" grid-area - the image
         alone, not the thumbnail rail, which is a separate sibling grid
         area - so a shadow here hugs the photo without clipping or
         pulling in the thumbnails. */
      [data-template='product'] .product-information__media slideshow-container {
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.1), 0 2px 6px rgba(0, 0, 0, 0.06) !important;
        /* Match the photo's own corner rounding (media_radius setting,
           20px) exactly - a mismatched radius here made the shadow's
           corners visibly a different shape than the photo's corners. */
        border-radius: 20px !important;
      }

      /* Trust bar (shipping/returns/secure payment) on the product page:
         each of the 3 boxes is height:auto, sized to its own content, and
         the row's default align-items:center leaves them free to differ in
         height instead of matching each other. "תשלום מאובטח" is a couple
         characters longer than the other two labels and was wrapping to a
         second line while its siblings stayed on one, making that box
         visibly taller. Stretching the row makes every box match the
         tallest one instead. */
      [data-template='product'] .group-block-content.layout-panel-flex--row:has(> .group-block .icon-block) {
        align-items: stretch !important;
      }

      /* Product card favorite/like heart: drop the native white circular
         backdrop. Previously used mix-blend-mode: difference to
         auto-contrast against the photo, but that inverts per pixel -
         white flips to black on light backgrounds, so it didn't actually
         stay white. Plain white now, with a soft drop shadow instead so
         it still reads clearly against light photos without changing
         color. */
      .favorite-toggle {
        background: transparent !important;
        box-shadow: none !important;
        color: #fff;
        filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.5));
        /* Nudged 5px further in from the image edges on both axes. */
        top: calc(var(--padding-sm, 16px) + 5px) !important;
        inset-inline-end: calc(var(--padding-sm, 16px) + 5px) !important;
      }
      /* One size step up the theme's own icon scale (sm -> md). */
      .favorite-toggle__icon {
        width: var(--icon-size-md);
        height: var(--icon-size-md);
      }
      /* Cart drawer/page line-item delete (trash) icon reads as too
         small/hard to notice for a destructive action button. The real
         cause, found via getComputedStyle in the live console: the
         generic .button:not(.button-secondary,.button-unstyled) rule
         sets padding: 12px 20px !important, which beats this button's
         own padding: 0 (not !important, lower specificity). Inside a
         44px-wide border-box button, 40px of horizontal padding leaves
         only ~4px of content-box width for anything inside - the icon
         was never actually shrinking to fit a real constraint, there
         was just no room to begin with, no matter what size CSS asked
         for. Raising this rule's own specificity (two-class selector,
         matching the competing rule's (0,2,0,0)) to reclaim that space
         with real !important priority. */
      .cart-items__quantity-controls .cart-items__remove {
        padding: 4px !important;
        flex-shrink: 0;
      }
      .cart-items__remove svg {
        width: 28px !important;
        height: 28px !important;
        max-width: none !important;
        max-height: none !important;
        flex-shrink: 0 !important;
      }

      /* Add to cart on product cards: a plain always-visible "הוסף לסל"
         button, instead of the native quick-add component (that one
         renders two buttons at once as a hover-only floating pill over
         the photo). blocks/_product-card-gallery.liquid renders it right
         after the image in the DOM, which is also where it stays
         visually (no order override) - before the group block, so above
         the title and price rather than below them. Small/fit-content,
         tight padding - a full-width bar read as too heavy for a card. */
      .product-card__quick-add-row {
        display: flex;
        justify-content: flex-end;
        order: 1;
      }
      .product-card__add-to-cart-button {
        width: fit-content;
        padding-inline: 14px;
        padding-block: 8px !important;
        font-size: 0.75rem;
        height: auto;
      }
      .product-card__add-to-cart-button .add-to-cart-icon {
        display: none;
      }
      @media screen and (max-width: 749px) {
        .product-card__add-to-cart-button {
          padding-inline: 17px !important;
          padding-block: 9.6px !important;
          font-size: 0.9rem !important;
        }
      }

      /* Generous padding across product cards: more room between cards in
         the grid, more room between the photo and the text block below
         it, and more room between the title/price/swatches lines inside
         that block - the default spacing read as cramped. */
      [product-grid-view] {
        --product-grid-gap: 32px !important;
      }
      .product-card__content {
        gap: 14px !important;
      }
      .product-card .group-block-content {
        gap: 8px !important;
        /* assets/base.css sets height: 100% globally on this class,
           stretching it to fill .group-block's full box regardless of
           actual content size - confirmed via devtools that this
           stretched box was the real element overlapping the top of
           the add-to-cart button below, not .group-block itself
           (which the earlier padding fix correctly sized). Sizing to
           actual content instead. */
        height: auto !important;
      }
      /* Matches the specificity of the older "Toylvia-style product
         cards" rule earlier in this file (.product-card
         .product-card__content > *:last-child, also !important) so this
         actually wins instead of losing the tie on source order. */
      .product-card .product-card__content > .group-block {
        padding: 12px 16px 0px !important;
      }
      /* Measured: with no negative margin the quick-add row already sits
         flush (0px gap) against .group-block, so any tightening at all
         necessarily overlaps it - and .group-block/.group-block-content
         come later in the DOM, so they paint on top and silently ate
         hover/clicks on whatever part of the button they covered (the
         long-running "top half of the button is dead" bug).
         Fixed structurally rather than by pixel-juggling: the two
         container elements are made transparent to the pointer, while
         their real content (title link, price, swatches) keeps normal
         hit-testing. Overlap can no longer steal input from the button
         underneath, which is what makes the negative margin below safe. */
      .product-card .product-card__content > .group-block,
      .product-card .group-block-content {
        pointer-events: none;
      }
      .product-card .group-block-content > * {
        pointer-events: auto;
      }
      /* The add-to-cart row had no side padding of its own, unlike
         .group-block above (20px), so it sat flush against the card's
         edge instead of inset like the title/price - reading as if it
         were sliding off the card. Match the same inset. */
      .product-card__quick-add-row {
        padding-inline: 16px;
        padding-block-end: 16px;
        /* Headroom for the button's own hover lift (translateY(-2px)
           scale(1.02)) to happen inside this row's box, safely within
           its own padding rather than relying on a margin that overlaps
           the previous sibling. Confirmed via getBoundingClientRect()
           logging that with margin-block-start at 0, this row already
           sits flush against .group-block's bottom edge with no gap
           and no overlap - there is no separate flex-gap contribution
           between these two specifically despite .product-card__content
           having gap: 14px (they are reordered via `order`, not actually
           adjacent in DOM/gap terms). An earlier version of this rule
           wrongly assumed a 14px gap needed cancelling and used a large
           negative margin, which measured out to overlapping directly
           into .group-block's (and its content's) own rendered box by
           the full margin amount - silently eating hover/click on
           whatever part of the button that overlap covered. */
        padding-block-start: 3px;
        box-sizing: border-box;
        width: 100%;
      }

      /* The "Toylvia-style product cards" rule earlier in this file
         draws a border-top on whichever element is DOM-last inside
         .product-card__content (.product-card .product-card__content >
         *:last-child) - that's .group-block, so left alone the line
         lands above the title, the very top of the text block. There's
         no divider inside the text block anymore (price now shares the
         star-rating line below), so cancel it everywhere it could
         plausibly still land - the group block itself, its inner
         content wrapper, and price/swatches individually. */
      .product-card .product-card__content > .group-block,
      .product-card .group-block-content,
      .product-card .group-block product-price,
      .product-card .group-block product-swatches {
        border-top: none !important;
      }
      /* Price used to be pulled out of flow (position: absolute) with a
         hardcoded top offset to overlay it on the fake star-rating row.
         That fake row is gone now, so the hardcoded offset no longer
         lines up with anything - removed, letting price sit in normal
         flow on its own line below the title again. */
      .product-card .group-block product-price {
        border: none !important;
        box-shadow: none !important;
        outline: none !important;
        text-decoration: none !important;
      }
      .product-card .group-block product-price * {
        border: none !important;
        box-shadow: none !important;
        outline: none !important;
        text-decoration: none !important;
      }

      /* Product page night-mode hover crossfade (same idea as the homepage
         banners): snippets/product-media-gallery-content.liquid renders this
         overlay only on the first slide, only when the product has a gallery
         image tagged "...לילה" in its alt text. .product-media-container
         already has position:relative + overflow:hidden natively, so it's
         the correct scope for both the absolute overlay and the :hover. */
      .product-media__night-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.8s ease;
        pointer-events: none;
        z-index: 1;
      }
      .product-media-container:is(:hover, .night-mode-active) .product-media__night-image {
        opacity: 1;
      }

      /* Quick-add pill label: native CSS only pads one side
         (padding-right), so the letter against the unpadded edge sits
         flush on .add-to-cart-text's overflow:hidden boundary and gets
         clipped. Balanced padding on all sides fixes it. Lives here
         (after content_for_header) because quick-add-styles.liquid's own
         stylesheet is bundled into content_for_header's output - same
         specificity + !important on both means the later one in source
         order wins, and that used to be theirs. */
      .quick-add__button .add-to-cart-text__content > span > span {
        padding: 4px 10px !important;
      }

      /* Quick-add button: thick black-ish border read as heavy/cheap,
         and the theme's default add-to-cart icon is a briefcase shape
         (same glyph as the header cart icon) rather than a real
         "add" symbol. Softer floating-pill treatment + a clean drawn
         plus sign instead. Icon swapped via CSS (not the shared SVG
         asset) so the main product page's Add to cart button, which
         reuses the same icon file, is untouched. */
      .quick-add__button {
        border: 1px solid rgba(26, 26, 46, 0.1) !important;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1) !important;
      }
      .quick-add__button .add-to-cart-icon svg {
        display: none !important;
      }
      .quick-add__button .add-to-cart-icon {
        position: relative;
      }
      .quick-add__button .add-to-cart-icon::before,
      .quick-add__button .add-to-cart-icon::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        background: currentColor;
        border-radius: 1px;
      }
      .quick-add__button .add-to-cart-icon::before {
        width: 13px;
        height: 1.5px;
        transform: translate(-50%, -50%);
      }
      .quick-add__button .add-to-cart-icon::after {
        width: 1.5px;
        height: 13px;
        transform: translate(-50%, -50%);
      }

      /* Collections page: match the product-card treatment (rounded, soft shadow, hover lift) */
      [data-template='list-collections'] .collection-card {
        border-radius: 14px !important;
        overflow: hidden !important;
        box-shadow: 0 2px 6px rgba(24, 24, 32, 0.06), 0 10px 22px rgba(24, 24, 32, 0.08) !important;
        transition: transform 0.18s ease, box-shadow 0.18s ease;
      }
      [data-template='list-collections'] .collection-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 10px rgba(24, 24, 32, 0.08), 0 16px 30px rgba(24, 24, 32, 0.12) !important;
      }

      /* חנות nav dropdown (collection thumbnails): the theme shows/hides
         this instantly with no transition at all, and stacks the 4
         collection thumbnails in one narrow column - felt jumpy and
         cramped, not premium. Adds a soft fade+slide reveal (with a short
         open delay so a quick pass over the link doesn't trigger it) and
         lays the thumbnails out as a proper 2x2 grid of square images. */
      .menu-list__list-item:where(:not([slot='overflow'])) > .menu-list__submenu {
        opacity: 0 !important;
        transform: translateY(-6px) !important;
        transition: opacity 0.24s ease-out !important, transform 0.24s ease-out !important,
          visibility 0s linear 0.24s !important;
      }
      .menu-list__list-item:has([aria-expanded='true']) > .menu-list__submenu,
      .menu-list__submenu:hover {
        opacity: 1 !important;
        transform: translateY(0) !important;
        transition-delay: 0.14s, 0.14s, 0s !important;
      }
      .menu-list__list-item:where(:not([slot='overflow'])) > .menu-list__submenu:has(.mega-menu__link-image) {
        min-width: 300px !important;
        max-width: 320px !important;
      }
      .menu-list__list-item:where(:not([slot='overflow']))
        > .menu-list__submenu
        .menu-list__submenu-inner:has(.mega-menu__link-image) {
        padding: 16px !important;
      }
      .menu-list__list-item:where(:not([slot='overflow']))
        > .menu-list__submenu
        .mega-menu__list:has(.mega-menu__link-image) {
        display: grid !important;
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 16px !important;
      }
      /* .mega-menu__column--wide-collection-image spans 2 of the theme's
         native 8-column desktop grid (its own gap-of-4 mode). Our override
         above only defines 2 columns total, so left as-is that class would
         span both of them and force one item per row - override it back to
         a single column so the 2x2 grid actually lands. */
      .menu-list__list-item:where(:not([slot='overflow']))
        > .menu-list__submenu
        .mega-menu__column:has(.mega-menu__link-image) {
        display: block !important;
        grid-column: span 1 !important;
      }
      .mega-menu__link-image {
        display: block !important;
        width: 100% !important;
        aspect-ratio: 1 / 1 !important;
        object-fit: cover !important;
        border-radius: 10px !important;
        border-style: solid !important;
        border-color: rgba(0, 0, 0, 0.14) !important;
        border-width: 0 1px 1px 0 !important;
        box-shadow: 0 -3px 5px rgba(24, 24, 32, 0.4), 0 0 4px rgba(24, 24, 32, 0.35),
          0 0 1px rgba(24, 24, 32, 0.45) !important;
        transition: transform 0.18s ease, box-shadow 0.18s ease !important;
      }
      .mega-menu__link:hover .mega-menu__link-image {
        transform: translateY(-2px) !important;
        box-shadow: 0 -4px 6px rgba(24, 24, 32, 0.45), 0 0 6px rgba(24, 24, 32, 0.4),
          0 0 2px rgba(24, 24, 32, 0.5) !important;
      }
      .mega-menu__list:has(.mega-menu__link-image) .mega-menu__link {
        display: block !important;
        text-align: center !important;
      }
      .mega-menu__list:has(.mega-menu__link-image) .wrap-text {
        display: block !important;
        margin-top: 8px !important;
        font-size: 0.85rem !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
      }

      /* Sticky quick-add bar: hidden below the viewport until JS (in
         snippets/sticky-buy-bar.liquid) adds --visible once the real buy
         box has scrolled out of view. Rendered outside .page-wrapper
         alongside the other overlays (cart drawer, search modal, etc.) so
         position: fixed is relative to the real viewport. */
      .sticky-buy-bar {
        position: fixed;
        inset-inline: 0;
        bottom: 0;
        z-index: var(--layer-sticky, 5);
        background: #ffffff;
        border-top: 1px solid #ececef;
        box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
        transform: translateY(100%);
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        padding-bottom: env(safe-area-inset-bottom, 0);
      }
      .sticky-buy-bar--visible {
        transform: translateY(0);
      }
      .sticky-buy-bar__inner {
        display: flex;
        align-items: center;
        gap: 14px;
        /* 85% of a tablet/desktop-width viewport is far more room than
           a thumbnail + price + button actually need - .sticky-buy-bar__info
           grows to fill it (flex:1), but its own text content stays
           hugging the thumbnail, so the leftover grown space becomes a
           big empty gap that reads as two disconnected floating pieces
           instead of one bar. Capping the width keeps them close
           together at any viewport size, same as it already looks on
           mobile where 85% is naturally small. */
        max-width: min(85%, 480px);
        margin-inline: auto;
        padding: 12px 20px;
      }
      .sticky-buy-bar__media {
        flex: 0 0 auto;
        width: 50px;
        height: 50px;
        border-radius: 10px;
        overflow: hidden;
        background: #f3f3f5;
      }
      .sticky-buy-bar__media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .sticky-buy-bar__info {
        flex: 1 1 auto;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .sticky-buy-bar__title {
        font-size: 0.9rem;
        color: #2f2f3a;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .sticky-buy-bar__price {
        font-size: 0.95rem;
        font-weight: 600;
        color: #1c1c24;
      }
      .sticky-buy-bar__cta {
        flex: 0 0 auto;
      }
      @media screen and (max-width: 749px) {
        .sticky-buy-bar__inner {
          max-width: 100%;
          padding: 10px 16px;
        }
        .sticky-buy-bar__title {
          display: none;
        }
      }

      /* Header top-level menu links, one type-scale step up (14px -> 16px).
         Overrides --menu-top-level-font-size directly rather than the
         shared --menu-font-sm--size preset it draws from, since that
         preset is also used by the submenu column headings - this way
         only the top-level nav bar text changes, nothing else. */
      .menu-list__link {
        --menu-top-level-font-size: 50px;
      }

      /* Live search results (assets/hebrew-live-search.js). Shopify's
         predictive search rejects Hebrew buyer locales, so these are
         rendered client-side from an inlined catalog instead. */
      .live-search-results {
        margin: 0;
        padding: 8px;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .live-search-results__link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px;
        border-radius: 10px;
        text-decoration: none;
        color: inherit;
        transition: background-color 0.15s ease;
      }
      .live-search-results__link:hover,
      .live-search-results__link:focus-visible {
        background: rgb(var(--color-foreground-rgb) / 0.06);
      }
      .live-search-results__image {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        object-fit: cover;
        border-radius: 8px;
        background: rgb(var(--color-foreground-rgb) / 0.06);
      }
      .live-search-results__text {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
      }
      .live-search-results__title {
        font-size: 0.95rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .live-search-results__price {
        font-size: 0.8rem;
        opacity: 0.7;
      }
      .live-search-results__empty {
        padding: 24px 16px;
        text-align: center;
        opacity: 0.7;
      }

      /* Price change feedback on the product page: picking a bigger size
         flashes the price red, a cheaper one flashes it green. Driven by
         assets/price-change-flash.js, which sets --price-flash-base to the
         element's own resolved colour first so the keyframes return to
         exactly that (using `inherit` here would resolve to the parent's
         colour and jump on the first frame). Three pulses each; green runs
         longer since a price drop is the friendlier news to dwell on. */
      @keyframes price-flash-up {
        0%, 100% { color: var(--price-flash-base, currentColor); }
        12%, 36%, 60% { color: #d93025; }
        24%, 48%, 72% { color: var(--price-flash-base, currentColor); }
      }
      /* A price drop blinks once - a single clear beat rather than the
         repeated pulse used to draw attention to an increase. */
      @keyframes price-flash-down {
        0%, 100% { color: var(--price-flash-base, currentColor); }
        35%, 65% { color: #1e8e3e; }
      }
      .price-flash--up {
        animation: price-flash-up 1.2s ease-in-out;
      }
      .price-flash--down {
        animation: price-flash-down 0.9s ease-in-out;
      }
      /* The price digits sit in nested wrappers (product-price >
         .price__regular > .price). Targeting only .price made it inherit from
         .price__regular - which is not animated - so the flash never showed.
         Every descendant has to pass the colour down from the animated
         element for the animation to reach the digits. */
      .price-flash--up *,
      .price-flash--down * {
        color: inherit !important;
      }

      /* Drawer slide-in used the shared --animation-speed token (0.125s),
         fast enough on this large a panel to read as an instant snap with
         no animation at all. Slowed down just for the drawer, without
         touching --animation-speed itself (used broadly elsewhere). */
      .theme-drawer__dialog--opening,
      .theme-drawer__dialog--opening-inline-start {
        animation-duration: 0.4s !important;
      }
    </style>
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        (function setHeaderHeighCustomProperties() {
          const header = document.querySelector('header-component');
          const headerGroup = document.querySelector('#header-group');
          const hasHeaderSection = headerGroup?.querySelector('.header-section');

          if (!header || !headerGroup) return;

          const headerTopRow = header.querySelector('.header__row--top');
          const headerHeight = header.offsetHeight;

          let headerGroupHeight = 0;
          const children = headerGroup.children;
          for (let i = 0; i < children.length; i++) {
            const element = children[i];
            if (element === header || !(element instanceof HTMLElement)) continue;
            headerGroupHeight += element.offsetHeight;
          }

          if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
            headerGroupHeight += headerHeight;
          }

          document.body.style.setProperty('--header-height', `${headerHeight}px`);
          document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

          if (headerTopRow) {
            window.requestAnimationFrame(function () {
              document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
            });
          }

          if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
            document.body.style.setProperty('--transparent-header-offset-boolean', '0');
            return;
          }

          const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

          const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
          document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
        })();

        (function setHeaderMenuStyle() {
          const headerComponent = document.querySelector('#header-component');
          if (headerComponent) {
            const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            const overflowList = headerComponent?.querySelector('overflow-list');
            const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
            headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
          }
        })();

        (function setAnnouncementBarStickyHeight() {
          const headerGroup = document.querySelector('#header-group');
          const announcementBarWrapper = headerGroup?.firstElementChild;
          if (!headerGroup || !announcementBarWrapper || !headerGroup.querySelector('header-component[sticky]')) {
            return;
          }
          function update() {
            const height = announcementBarWrapper.classList.contains('header-section')
              ? 0
              : announcementBarWrapper.offsetHeight;
            document.body.style.setProperty('--announcement-bar-sticky-height', `${height - 1}px`);
          }
          update();
          window.addEventListener('resize', update);
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {{ content_for_layout }}
      </main>

      <footer>
        {% sections 'footer-group' %}
      </footer>
    </div>

    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'favorites-drawer' %}
    {% render 'theme-drawer' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}


    {% render 'hero-night-mode' %}
    <script src="{{ 'led-color-swatches.js' | asset_url }}" defer></script>
    <script src="{{ 'menu-scroll-shrink.js' | asset_url }}" defer></script>
    <script src="{{ 'product-card-cta-hover.js' | asset_url }}" defer></script>
    <script src="{{ 'hebrew-live-search.js' | asset_url }}" defer></script>
    {% if request.page_type == 'product' %}
      <script src="{{ 'price-change-flash.js' | asset_url }}" defer></script>
    {% endif %}
    <style>html,body,*{scrollbar-width:none!important;-ms-overflow-style:none!important}::-webkit-scrollbar{width:0!important;height:0!important;display:none!important}</style>
    <script>
      (function () {
        function initHeaderScrolledShadow() {
          var header = document.getElementById('header-component');
          if (!header) return;

          var desktopQuery = window.matchMedia('(min-width: 990px)');

          function getScrollEl() {
            if (desktopQuery.matches) {
              return document.querySelector('.page-wrapper') || document.scrollingElement || document.documentElement;
            }
            return document.scrollingElement || document.documentElement;
          }

          var scrollEl = getScrollEl();

          function onScroll() {
            header.classList.toggle('header--scrolled', scrollEl.scrollTop > 4);
          }

          scrollEl.addEventListener('scroll', onScroll, { passive: true });

          desktopQuery.addEventListener('change', function () {
            scrollEl.removeEventListener('scroll', onScroll);
            scrollEl = getScrollEl();
            onScroll();
            scrollEl.addEventListener('scroll', onScroll, { passive: true });
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initHeaderScrolledShadow);
        } else {
          initHeaderScrolledShadow();
        }
      })();
    </script>
    <script id='merchantWidgetScript' src="https://www.gstatic.com/shopping/merchant/merchantwidget.js" defer></script>
    <script>
    merchantWidgetScript.addEventListener('load', function () {
    merchantwidget.start({merchant_id: 5827201311});
    });
    </script>
  </body>
</html>
