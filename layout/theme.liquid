    {{ content_for_header }}

    <style>
      /* All product-card badges (sale, sold-out, featured) hidden per
         request - removes the "מבצע" and "מומלץ" tags from cards. */
      .product-badges {
        display: none !important;
      }

      /* Featured-product badge (see _product-card-gallery.liquid): the one
         hierarchy signal the product grid otherwise has none of. Placed in
         THIS block, not the main one above - product-badges-styles.liquid's
         base .product-badges__badge background rule is part of Shopify's
         bundled per-component CSS injected via content_for_header, which
         lands after the main style block and silently won the equal-
         specificity tie there (first found live on the store/collection
         page: the badge rendered in --color-background grey, not amber). */
      .product-badges__badge--featured {
        background: var(--color-accent-amber, #e8a33d) !important;
        /* Fixed to the sale badge's literal text color setting, not the
           ambient --color-foreground var - that one is color-scheme
           relative and flips to white on sections using a dark scheme,
           while the sale badge (via the contrast-override snippet) always
           locks its own scoped --color-foreground to this same setting
           regardless of scheme. */
        color: {{ settings.badge_sale_text_color }} !important;
      }

      /* Product page: the whole top section (image, title, price, variant picker,
         buy buttons, trust bar, description, accordion) as ONE unified card.
         Deliberately placed after content_for_header — Shopify's own per-section/component
         CSS is injected there, landing after the main style block above and beating any
         !important set earlier via source-order tie-breaking. This block must stay last. */
      [data-template='product'] .product-information__grid {
        background: #f7f5f2 !important;
        border-radius: 32px !important;
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.1), 0 2px 6px rgba(0, 0, 0, 0.06) !important;
        padding: 32px !important;
        margin-inline: auto !important;
        align-items: stretch !important;
      }
      /* max-width:85% here was unconditional, only ever undone by the
         max-width:100% further down scoped to <=749px. Tablet widths
         (roughly 750-989px) got neither: 85% of an already-narrow tablet
         viewport, combined with the native grid's sidebar-width-based
         column math, squeezed the image column down to a sliver (~24px -
         effectively invisible) since the details column claims a near-
         fixed width first and the image only gets whatever's left over.
         Only apply the narrower card width once the viewport is wide
         enough (matching this theme's own desktop breakpoint) that 85%
         still leaves the image a real column. */
      @media screen and (min-width: 990px) {
        [data-template='product'] .product-information__grid {
          max-width: 85% !important;
        }
      }
      /* Even with the 85% cap gone below 990px, the grid was still only
         claiming part of its own column track (subgrid sizing to some
         intrinsic width instead of the full track) - explicit 100% forces
         it to actually fill the space it has, which is what gives the
         image column room to exist instead of collapsing to a sliver. */
      @media screen and (max-width: 989px) {
        [data-template='product'] .product-information__grid {
          width: 100% !important;
        }
      }

      @media screen and (min-width: 750px) {
        /* Native theme CSS (.product-details product-price > * { text-align:
           left }) has slightly higher specificity than the .text-right
           utility class the price block's own alignment setting relies on,
           so it was silently winning over the "align right" choice made in
           the theme editor - force it here instead. */
        [data-template='product'] .product-details product-price,
        [data-template='product'] .product-details product-price > * {
          text-align: right !important;
        }
        [data-template='product'] .product-details product-price {
          font-size: 1.125rem !important;
        }
        [data-template='product'] .product-information__media {
          /* The frame is square, so its height follows its width. Narrowing
             the column by 15% is what shortens the image - the carousel needs
             the slide itself to stay width:100%, so the size has to come from
             here rather than from the slide. */
          width: 85% !important;
          margin-inline: auto !important;
          height: auto !important;
          align-self: start !important;
          display: flex !important;
          justify-content: center !important;
        }
        [data-template='product'] .product-information__media media-gallery {
          display: flex !important;
          flex-direction: column !important;
          width: 100% !important;
          height: 100% !important;
        }
        /* The gallery web component nests slideshow-component > slideshow-container >
           slideshow-slides > .product-media-container (slideshow-slide) before reaching
           the image. Each of those has to be told to fill height too, or the stretch
           stops at whichever level is still sized to its content. */
        [data-template='product'] .product-information__media slideshow-component {
          flex: 1 1 auto !important;
          min-height: 0 !important;
        }
        [data-template='product'] .product-information__media slideshow-container,
        [data-template='product'] .product-information__media slideshow-slides {
          height: 100% !important;
        }
        [data-template='product'] .product-information__media .product-media-container {
          /* Theme's base.css sets aspect-ratio + a max-height capped to ~viewport
             height on .constrain-height; both override a plain height:100%, so they
             have to be neutralized explicitly for the image to actually reach the
             card's full height instead of stopping early. */
          /* Square, and 15% shorter than the details column beside it. Width
             follows from the ratio, so the frame stays square at any column
             height and the photo still fills it via object-fit: cover. */
          aspect-ratio: 1 / 1 !important;
          max-height: none !important;
          height: auto !important;
          /* NOT flex: 1 - the native rule for this element is
             width: var(--slide-width, 100%), each slide taking the full row
             width with horizontal scroll-snap between them. flex: 1 sets
             flex-basis: 0%, which overrides that width entirely - with 2
             slides in the row they'd each just grow to fill half the
             available space, rendering side by side instead of full-width
             with one visible at a time. Height still stretches fine without
             it (cross-axis stretch doesn't need flex-grow on the main axis). */
          width: 100% !important;
          min-height: 0 !important;
        }
        /* The gallery wraps the photo in .product-media-constraint-wrapper >
           .product-media, both of which carry their own 1:1 aspect-ratio. Left
           alone they cap the photo at its square height inside a taller frame,
           which reads as letterboxing. */
        [data-template='product'] .product-information__media .product-media-container .product-media-constraint-wrapper,
        [data-template='product'] .product-information__media .product-media-container .product-media,
        [data-template='product'] .product-information__media .product-media-container .product-media-constraint-wrapper .product-media {
          aspect-ratio: auto !important;
          height: 100% !important;
          width: 100% !important;
        }
        [data-template='product'] .product-information__media .product-media-container img.product-media__image {
          width: 100% !important;
          height: 100% !important;
          object-fit: cover !important;
          aspect-ratio: auto !important;
          transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        /* Subtle zoom on hover so the wood grain and laser-cut detail read
           as tangible, not just a flat photo. .product-media-container
           already clips overflow, so this can't spill past the rounded
           corners. */
        [data-template='product'] .product-information__media .product-media-container:hover img.product-media__image {
          transform: scale(1.04) !important;
        }
        /* Left-side thumbnail rail: the theme stretches slideshow-controls to the
           full image height via the gallery's grid, but its own
           slideshow-controls__thumbnails-container only sizes to its (few)
           thumbnails and the outer flex box defaults to justify-content:
           space-between, which shoves that short stack to the top and leaves
           the rest of the tall rail empty. Center it instead so a handful of
           thumbnails read as a deliberate rail, not a layout accident. */
        [data-template='product'] .product-information__media slideshow-controls[pagination-position='left'] {
          justify-content: center !important;
          gap: 14px !important;
        }
        /* RTL grid-template swap: the native grid-template for
           pagination-position="left"/"right" names its first track/area at
           the layout's inline-start edge, which under this document's
           dir="rtl" is the physical RIGHT, not the left the setting name
           implies (and vice versa for "right") - so "left" was rendering
           the thumbnail rail on the physical right. Swapping which
           template string each value uses puts the rail back on the side
           the setting actually says. */
        .media-gallery--carousel slideshow-component:has(slideshow-controls[thumbnails]):has(slideshow-controls[pagination-position='left']) {
          grid-template:
            'container controls' auto
            'arrows controls' min-content
            / 1fr auto !important;
          gap: 16px !important;
        }
        .media-gallery--carousel slideshow-component:has(slideshow-controls[thumbnails]):has(slideshow-controls[pagination-position='right']) {
          grid-template:
            'controls container' auto
            'controls arrows' min-content
            / auto 1fr !important;
          gap: 16px !important;
        }
      }
      @media screen and (max-width: 749px) {
        [data-template='product'] .product-information__grid {
          border-radius: 20px !important;
          padding: 16px !important;
          max-width: 100% !important;
        }
        [data-template='product'] .product-details {
          margin-top: 40px !important;
        }
        /* Pulls the Add to Cart row closer to the variant picker above it -
           the group's own block gap read as too much empty space directly
           over the button. */
        [data-template='product'] .product-form-buttons {
          margin-top: -8px !important;
        }
        [data-template='product'] .product-form-buttons .add-to-cart-button {
          padding-block: 24px !important;
          padding-inline: 31px !important;
          font-size: 1.32rem !important;
        }
        /* Title up one more size step, price down one size step. */
        [data-template='product'] .product-details h1 {
          font-size: 4.1rem !important;
        }
        [data-template='product'] .product-details product-price {
          font-size: 1.7rem !important;
        }
        /* The PayPal/accelerated-checkout button sat right in the same
