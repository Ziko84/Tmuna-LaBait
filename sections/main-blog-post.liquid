

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div class="section{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% content_for 'blocks' %}
    {%- comment -%}related products per guide topic: user 2026-11-22{%- endcomment -%}
    {%- assign bp_text = article.title | append: ' ' | append: article.handle -%}
    {%- if bp_text contains 'כלב' -%}{%- assign bp_handle = 'dogs' -%}
    {%- elsif bp_text contains 'גיאומטר' -%}{%- assign bp_handle = 'geometric-animals' -%}
    {%- elsif bp_text contains 'טבע' or bp_text contains 'יער' or bp_text contains 'נוף' or bp_text contains 'אגם' or bp_text contains 'שקיעה' or bp_text contains 'מדבר' -%}{%- assign bp_handle = 'nature-scenes' -%}
    {%- elsif bp_text contains 'סלון' -%}{%- assign bp_handle = 'living-room-wall-art' -%}
    {%- else -%}{%- assign bp_handle = 'frontpage' -%}{%- endif -%}
    {%- assign bp_coll = collections[bp_handle] -%}
    {%- if bp_coll.products_count > 0 -%}
    <div class="blog-related-products">
      <h2 class="blog-related-products__title">יצירות שמתאימות למדריך</h2>
      <div class="blog-related-products__grid">
        {%- for p in bp_coll.products limit: 4 -%}
          <a class="blog-related-products__item" href="{{ p.url }}">
            {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: p.title, width: 400, height: 400 }}{%- endif -%}
            <span>{{ p.title }}</span>
          </a>
        {%- endfor -%}
      </div>
      <a class="blog-related-products__all" href="{{ bp_coll.url }}">לכל היצירות בקטגוריה</a>
    </div>
    {%- endif -%}

    {% if blog.comments_enabled? %}
      <div class="blog-post-comments-container">
        <h2 class="h3">{{- 'blogs.article.comments_heading' | t: count: article.comments_count -}}</h2>

        <div class="blog-post-comments">
          {% paginate article.comments by 10 %}
            {% for comment in article.comments %}
              <div class="blog-post-comment">
                {{ comment.content }}
                <div class="blog-post-comment__author">
                  <span class="blog-post-comment__author-name">{{- comment.author -}}</span>
                  <span>{{- 'blogs.article.comment_author_separator' | t -}}</span>
                  <span class="blog-post-comment__date">
                    {{- comment.created_at | time_tag: format: 'date' -}}
                  </span>
                </div>
              </div>
            {% endfor %}

            <div class="blog-post-comments-pagination">
              {{- paginate | default_pagination -}}
            </div>
          {% endpaginate %}
        </div>

        {% render 'blog-comment-form', article: article, section_id: section.id %}
      </div>
    {% endif %}
  </div>
</div>

{%- comment -%}
  Hand-authored BlogPosting instead of the native `article | structured_data`
  filter (which outputs @type: Article with no publisher.logo). Same logo
  source as the site-wide Organization schema in snippets/meta-tags.liquid,
  so the two stay consistent.
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ article.url | prepend: shop.url | json }}
  },
  "headline": {{ article.title | json }},
  "description": {{ article.excerpt | replace: '<', ' <' | strip_html | strip_newlines | default: article.content | replace: '<', ' <' | strip_html | strip_newlines | truncate: 300 | json }},
  {% if article.image %}"image": {{ article.image | image_url: width: 1920 | prepend: "https:" | json }},{% endif %}
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "author": {
    "@type": "Person",
    {%- if article.author != blank and article.author != shop.name %}
    "name": {{ article.author | json }}
    {%- else %}
    "name": "דניאל אמינוב",
    "jobTitle": "מייסד ומעצב",
    "url": {{ shop.url | append: '/pages/our-story' | json }},
    "worksFor": {"@type": "Organization", "name": {{ shop.name | json }}}
    {%- endif %}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }}
    {% if settings.logo %},
    "logo": {
      "@type": "ImageObject",
      "url": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }}
    }
    {% endif %}
  }
}
</script>

{% stylesheet %}
  .blog-post-comments-container {
    width: 100%;
    max-width: var(--normal-content-width);
    margin: 0 auto;
  }

  .blog-post-comments {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xl);
  }

  .blog-post-comment__author {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    margin-top: var(--margin-md);
    font-size: var(--font-size--body-sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .blog-post-comments-pagination {
    display: flex;
    justify-content: center;
    gap: var(--gap-2xs);
  }

  .blog-post-comments-pagination,
  .blog-post-comments-pagination a {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a {
    display: block;
    padding: var(--padding-2xs) var(--padding-xs);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a:hover {
    border-bottom: 1px solid var(--color-foreground);
  }
{% endstylesheet %}

{% style %}
  .blog-related-products { max-width: var(--normal-content-width, 800px); margin: 3rem auto 2rem; padding-inline: 16px; text-align: center; }
  .blog-related-products__title { margin: 0 0 1.25rem; }
  .blog-related-products__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  @media (max-width: 749px) { .blog-related-products__grid { grid-template-columns: repeat(2, 1fr); } }
  .blog-related-products__item { display: block; text-decoration: none; color: inherit; }
  .blog-related-products__item img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; display: block; }
  .blog-related-products__item span { display: block; margin-top: 6px; font-size: 0.95rem; }
  .blog-related-products__all { display: inline-block; margin-top: 1.25rem; text-decoration: underline; text-underline-offset: 3px; color: inherit; }
{% endstyle %}

{% schema %}
{
  "name": "t:names.blog_post",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_blog-post-title"
    },
    {
      "type": "_blog-post-info-text"
    },
    {
      "type": "_blog-post-featured-image"
    },
    {
      "type": "_blog-post-content"
    }
  ],
  "class": "section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}

