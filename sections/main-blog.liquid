

<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<blog-posts-list section-id="{{ section.id }}">
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div
    class="
      section
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      blog-posts
      spacing-style
      size-style
    "
    data-testid="blog-posts"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% content_for 'blocks' %}

    {%- comment -%}
      templates/blog.json's banner section is stuck on a GitHub-synced
      copy that never picks up settings changes (the same per-file
      sync-pinning issue documented on templates/product.json, see
      product-info-panel.liquid), so a subtitle block added there there
      never reaches the live theme. Rendered here instead, in this
      section's own working Liquid file, positioned so it still reads as
      the page intro directly under the "בלוג" heading above it.
    {%- endcomment -%}
    <p class="blog-posts__intro">טיפים, השראה וסיפורים מאחורי היצירות שלנו.</p>

    <div
      ref="grid"
      class="blog-posts-container"
    >
      {% liquid
        assign items_on_page = blog.articles.size
      %}
      {% for article in blog.articles %}
        {% liquid
          # The latest post (first in the loop) gets the wide, featured
          # horizontal treatment. Everything else stays the uniform grid.
          assign col_span = 2
          assign scale = 0.8
          assign is_featured = false

          if items_on_page == 1
            assign col_span = 6
          elsif items_on_page == 2
            assign col_span = 3
          elsif forloop.first
            assign col_span = 6
            assign is_featured = true
          endif
        %}
        {% style %}
          [data-blog-index="{{ section.id }}-{{ forloop.index }}"] {
            --col-span: {{ col_span }};
            --blog-post-card-scale: {{ scale }};
          }

          @media screen and (max-width: 749px) {
            [data-blog-index="{{ section.id }}-{{ forloop.index }}"] {
              --col-span: 6;
              --blog-post-card-scale: 0.5;
            }
          }
        {% endstyle %}
        <div
          class="blog-post-item{% if is_featured %} blog-post-item--horizontal blog-post-item--featured{% endif %}"
          data-testid="blog-post-item"
          data-blog-index="{{ section.id }}-{{ forloop.index }}"
        >
          {% if is_featured %}
            <span class="blog-post-item__eyebrow">הפוסט האחרון</span>
          {% endif %}
          {% content_for 'block', id: 'static-blog-post-card', type: '_blog-post-card', article: article %}
        </div>
      {% endfor %}
    </div>
  </div>
</blog-posts-list>

{% stylesheet %}
  /**
   * Blog posts page layout
   */
  .blog-posts {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
    --columns-gap: 36px;
    --rows-gap: 36px;
  }

  .blog-posts__intro {
    text-align: center;
    max-width: 46ch;
    margin: -8px auto 32px;
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .blog-posts-container {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
    width: 100%;
    column-gap: var(--columns-gap);
    row-gap: var(--rows-gap);
  }

  /**
   * Blog post item grid positioning and scaling.
   * Layout is calculated in Liquid based on total article count.
   * Mobile overrides are applied per-item in inline styles for proper specificity.
   */
  .blog-post-item {
    grid-column: span var(--col-span);
    background-color: var(--color-background);
  }

  /**
   * When there's no image, the blog post item has a border.
   */
  .blog-post-item {
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    padding: 0 1rem 1rem;
  }

  /**
   * The latest post spans the full row, reusing the theme's existing
   * horizontal card layout (image/content 70-30 split) instead of a new
   * one, so it reads as clearly larger than the grid below it.
   */
  .blog-post-item--featured {
    margin-block-end: 8px;
  }

  .blog-post-item__eyebrow {
    display: block;
    margin-block-end: 12px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-accent-amber, #e8a33d);
  }

  .blog-post-item:has(.blog-post-card__image-container) {
    border: none;
    padding: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
