{% stylesheet %}
.lc-rec__head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin:0 0 20px}
.lc-rec__heading{font-size:1.4rem;font-weight:400;color:#1a1a2e;margin:0}
.lc-rec__all{font-size:.8rem;color:#8a6e46;text-decoration:none;white-space:nowrap}
.lc-rec__all:hover{text-decoration:underline}
.lc-rec__card{display:block;text-decoration:none;color:#1a1a2e}
.lc-rec__media{aspect-ratio:1/1;border-radius:16px;overflow:hidden;background:#f0efeb;margin-bottom:10px}
.lc-rec__media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}
.lc-rec__card:hover .lc-rec__media img{transform:scale(1.04)}
.lc-rec__name{font-size:.92rem;line-height:1.4}
.lc-rec__price{font-size:.92rem;color:#6d685f;margin-top:2px}
.lc-rec__card--ph{opacity:0}
{% endstylesheet %}
