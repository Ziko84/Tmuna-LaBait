

{% liquid
  assign max_items = section.settings.max_products
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign display_collection = section.settings.collection

  if section.settings.collection_mode == 'same_as_product' and closest.product != blank
    assign display_collection = blank
    for pc in closest.product.collections
      if pc.handle != 'frontpage' and display_collection == blank
        assign display_collection = pc
      endif
    endfor
  elsif section.settings.collection_mode == 'different_from_product' and closest.product != blank
    assign display_collection = blank
    for c in collections
      assign is_excluded = false
      if c.handle == 'frontpage' or c.products_count == 0
        assign is_excluded = true
      endif
      unless is_excluded
        for pc in closest.product.collections
          if pc.handle == c.handle
            assign is_excluded = true
          endif
        endfor
      endunless
      if is_excluded == false and display_collection == blank
        assign display_collection = c
      endif
    endfor
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  data-testid="product-list"
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    section-resource-list
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  <div class="section-resource-list__header lc-rec__head">
    <h2 class="lc-rec__heading">עוד מאותה קטגוריה</h2>
    {% if display_collection != blank %}<a class="lc-rec__all" href="{{ display_collection.url }}">לצפייה בכל הקטגוריה</a>{% endif %}
  </div>

  {% capture list_items %}
    {% if display_collection != blank and shop.products_count != 0 %}
      {% comment %}
        Fetch one extra so the grid still fills max_items slots after the
        current product (closest.product) is skipped below - without this,
        viewing a product from this same collection would show it in its
        own "discover the collection" grid, and the grid would come up one
        item short whenever that happens.
      {% endcomment %}
      {% assign fetch_limit = max_items | plus: 1 %}
      {% paginate display_collection.products by fetch_limit %}
        {% assign shown_count = 0 %}
        {% for product in display_collection.products %}
          {% if closest.product != blank and product.id == closest.product.id %}
            {% continue %}
          {% endif %}
          {% if shown_count >= max_items %}
            {% break %}
          {% endif %}
          {% if shown_count > 0 %}
            <!--@list/split-->
          {% endif %}
          {% assign shown_count = shown_count | plus: 1 %}
          <div
            class="resource-list__item"
          >
            <a class="lc-rec__card" href="{{ product.url }}">
              <div class="lc-rec__media">{% if product.featured_media %}<img src="{{ product.featured_media | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" width="600" height="600">{% endif %}</div>
              <div class="lc-rec__name">{{ product.title }}</div>
              <div class="lc-rec__price">{{ product.price | money }}</div>
            </a>
          </div>
        {% endfor %}
      {% endpaginate %}
    {% else %}
      {% for i in (1..max_items) %}
        <div
          class="resource-list__item"
        >
<div class="lc-rec__card lc-rec__card--ph"></div>
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endif %}
  {% endcapture %}

  {% liquid
    # Create an array from the list items to be used for different layout types
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    slide_count: max_items,
    content_type: 'products',
    test_id: 'resource-list-grid'
  %}

  <div
    class="section-resource-list__content"
    style="--horizontal-alignment: {{ section.settings.horizontal_alignment }};"
  >
    {%- content_for 'blocks' -%}
  </div>
</div>

