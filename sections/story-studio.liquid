{%- doc -%}
  Our Story page, full build: full-bleed hero photo with the page's only H1,
  the two founders, narrative text beside a supporting photo, the workshop
  equipment as a bento grid, and a closing quote with a CTA. Replaces the
  separate banner / editorial / studio / philosophy sections this page used
  to be split across, so there is exactly one H1 on the page instead of two.
{%- enddoc -%}

<div
  class="story-studio"
  style="background-color: {{ section.settings.background_color }};"
>
  {% if section.settings.hero_image != blank %}
    <div class="story-studio__hero">
      {{
        section.settings.hero_image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.hero_image.alt,
          sizes: '100vw',
          widths: '750, 1100, 1500, 2000'
      }}
      <h1 class="story-studio__hero-heading">{{ section.settings.headline }}</h1>
    </div>
  {% endif %}

  <reveal-on-scroll class="story-studio__team">
    {% for block in section.blocks %}
      {% if block.type == 'team_member' %}
        <div class="story-studio__member" {{ block.shopify_attributes }}>
          {% if block.settings.photo != blank %}
            <div class="story-studio__member-photo">
              {{
                block.settings.photo
                | image_url: width: 200
                | image_tag: loading: 'lazy', alt: block.settings.photo.alt, sizes: '84px', widths: '84, 128, 168'
              }}
            </div>
          {% endif %}
          <div class="story-studio__member-text">
            <p class="story-studio__member-name">{{ block.settings.name }}</p>
            {% if block.settings.role != blank %}
              <p class="story-studio__member-role">{{ block.settings.role }}</p>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </reveal-on-scroll>

  <reveal-on-scroll class="story-studio__body">
    <div class="story-studio__body-text">{{ section.settings.body }}</div>
    {% if section.settings.body_image != blank %}
      <div class="story-studio__body-photo">
        {{
          section.settings.body_image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            alt: section.settings.body_image.alt,
            sizes: '(min-width: 750px) 50vw, 100vw',
            widths: '400, 700, 1000, 1200'
        }}
      </div>
    {% endif %}
  </reveal-on-scroll>

  {% if section.settings.equipment_heading != blank %}
    <div class="story-studio__bento-head">
      <h2>{{ section.settings.equipment_heading }}</h2>
    </div>
  {% endif %}

  <reveal-on-scroll class="story-studio__bento">
    {% for block in section.blocks %}
      {% if block.type == 'workshop_photo' and block.settings.image != blank %}
        <div
          class="story-studio__tile story-studio__tile--{{ block.settings.tile_size }}"
          {{ block.shopify_attributes }}
        >
          {{
            block.settings.image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              alt: block.settings.image.alt,
              sizes: '(min-width: 750px) 25vw, 50vw',
              widths: '300, 500, 700, 1000'
          }}
          {% if block.settings.caption != blank %}
            <span class="story-studio__tile-caption">{{ block.settings.caption }}</span>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </reveal-on-scroll>

  {% if section.settings.quote != blank %}
    <div class="story-studio__quote-band">
      <p>{{ section.settings.quote }}</p>
      {% if section.settings.quote_cta_label != blank and section.settings.quote_cta_link != blank %}
        <a href="{{ section.settings.quote_cta_link }}">{{ section.settings.quote_cta_label }}</a>
      {% endif %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .story-studio h1,
  .story-studio h2 {
    font-family: var(--font-heading--family);
    font-weight: 400;
    margin: 0;
  }

  .story-studio h2 {
    color: #1a1a2e;
  }

  /* Hero: full-bleed photo, the headline overlaid is this page's only H1 */
  .story-studio__hero {
    position: relative;
    aspect-ratio: 21 / 8;
    max-height: 440px;
  }

  @media screen and (max-width: 749px) {
    .story-studio__hero {
      aspect-ratio: 4 / 5;
    }
  }

  .story-studio__hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .story-studio__hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(18, 18, 24, 0.72) 0%, rgba(18, 18, 24, 0.15) 45%, transparent 70%);
  }

  .story-studio__hero-heading {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    padding: 32px clamp(20px, 4vw, 56px) 40px;
    color: #ffffff;
    font-size: clamp(1.9rem, 1.4rem + 2vw, 2.9rem);
    line-height: 1.18;
    max-width: 18ch;
    text-align: end;
    margin-inline-start: auto;
  }

  /* Team, immediately below the hero: two founders, amber-ringed portraits */
  .story-studio__team {
    display: flex;
    flex-wrap: wrap;
    border-bottom: 1px solid rgb(26 26 46 / 8%);
  }

  .story-studio__member {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 28px clamp(20px, 4vw, 56px);
    flex: 1 1 320px;
  }

  .story-studio__member + .story-studio__member {
    border-inline-start: 1px solid rgb(26 26 46 / 8%);
  }

  .story-studio__member-photo {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    overflow: hidden;
    flex: none;
    outline: 3px solid var(--color-accent-amber, #e8a33d);
    outline-offset: 3px;
  }

  .story-studio__member-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .story-studio__member-name {
    font-size: 1.05rem;
    font-weight: 600;
    color: #1a1a2e;
    margin: 0 0 4px;
  }

  .story-studio__member-role {
    margin: 0;
    color: #5a554d;
    font-size: 0.88rem;
    line-height: 1.5;
    max-width: 26ch;
  }

  /* Body: narrative text beside a supporting photo. In this RTL page the
     text stays first in source order (the visual start / right side), the
     photo second (the visual end / left side). */
  .story-studio__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    padding: 56px clamp(20px, 4vw, 56px);
    max-width: 1180px;
    margin-inline: auto;
  }

  .story-studio__body-text p {
    line-height: 1.75;
    color: #5a554d;
    margin: 0 0 16px;
    font-size: 1rem;
  }

  .story-studio__body-text p:last-child {
    margin-block-end: 0;
  }

  .story-studio__body-photo {
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    overflow: hidden;
  }

  .story-studio__body-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .story-studio__body {
      grid-template-columns: 1fr;
      padding-block: 40px;
    }

    .story-studio__body-photo {
      order: -1;
    }
  }

  .story-studio__bento-head {
    padding: 40px clamp(20px, 4vw, 56px) 20px;
    max-width: 1180px;
    margin-inline: auto;
  }

  .story-studio__bento-head h2 {
    font-size: 1.5rem;
  }

  /* Equipment as a real bento grid, mixed tile sizes, not a uniform repeat */
  .story-studio__bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 130px;
    gap: 12px;
    padding: 0 clamp(20px, 4vw, 56px) 56px;
    max-width: 1180px;
    margin-inline: auto;
  }

  .story-studio__tile {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
  }

  .story-studio__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .story-studio__tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(18, 18, 24, 0.6), transparent 55%);
  }

  .story-studio__tile-caption {
    position: absolute;
    bottom: 10px;
    inset-inline-end: 14px;
    color: #ffffff;
    font-size: 0.82rem;
    z-index: 2;
  }

  .story-studio__tile--wide {
    grid-column: span 2;
  }

  .story-studio__tile--big {
    grid-column: span 2;
    grid-row: span 2;
  }

  @media screen and (max-width: 749px) {
    .story-studio__bento {
      grid-template-columns: repeat(2, 1fr);
    }

    .story-studio__tile--big {
      grid-column: span 2;
    }
  }

  .story-studio__quote-band {
    background: #efeade;
    padding: 48px clamp(20px, 4vw, 56px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .story-studio__quote-band p {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 1.3rem;
    max-width: 34ch;
    margin: 0;
    color: #1a1a2e;
  }

  .story-studio__quote-band a {
    padding: 12px 26px;
    border-radius: 10px;
    background: #1a1a2e;
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .story-studio reveal-on-scroll.is-observing {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .story-studio reveal-on-scroll.is-observing.is-revealed {
      opacity: 1;
      transform: translateY(0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Story studio",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero photo"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline (page H1)",
      "default": "מהסקיצה הראשונה ועד הקיר שלכם"
    },
    {
      "type": "text",
      "id": "body",
      "label": "Body text (HTML)",
      "default": "<p>כל יצירה מתחילה בסקיצה. עיפרון על נייר, לפני שהיא הופכת לקובץ, ולפני שהיא הופכת לעץ.</p><p>אנחנו צוות קטן, שני אנשים בלבד, שבוחרים בקפידה MDF איכותי ועמיד לכל יצירה, ואז חורטים אותה במכונת הלייזר שלנו בדיוק של שבריר מילימטר.</p><p>אנחנו לא עובדים עם ספקים או מתווכים. כל שלב, מהסקיצה ועד ההרכבה הסופית, קורה כאן, באולפן שלנו, והיצירה מגיעה אליכם מוכנה לתלייה.</p>"
    },
    {
      "type": "image_picker",
      "id": "body_image",
      "label": "Photo beside the body text"
    },
    {
      "type": "text",
      "id": "equipment_heading",
      "label": "Equipment section heading",
      "default": "הציוד באולפן"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Closing quote",
      "default": "אנחנו מאמינים שאמנות טובה לא צריכה לצעוק. היא נוכחת בשקט, מדויקת, ונשארת רלוונטית שנים קדימה."
    },
    {
      "type": "text",
      "id": "quote_cta_label",
      "label": "Quote CTA label",
      "default": "למעבר לקולקציות"
    },
    {
      "type": "url",
      "id": "quote_cta_link",
      "label": "Quote CTA link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f5f2"
    }
  ],
  "blocks": [
    {
      "type": "team_member",
      "name": "Team member",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role" }
      ]
    },
    {
      "type": "workshop_photo",
      "name": "Workshop photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption (optional)" },
        {
          "type": "select",
          "id": "tile_size",
          "label": "Tile size",
          "options": [
            { "value": "normal", "label": "Normal" },
            { "value": "wide", "label": "Wide (2 columns)" },
            { "value": "big", "label": "Big (2x2)" }
          ],
          "default": "normal"
        }
      ]
    }
  ],
  "max_blocks": 14,
  "presets": [
    {
      "name": "Story studio",
      "blocks": [
        { "type": "team_member" },
        { "type": "team_member" },
        { "type": "workshop_photo" },
        { "type": "workshop_photo" },
        { "type": "workshop_photo" }
      ]
    }
  ]
}
{% endschema %}
