{% comment %}
  Renders a Shopify policy (/policies/*) with the same presentation as the
  themed policy pages under /pages/*. Identical markup and class names to
  sections/policy-page.liquid, driven by the `policy` object instead of `page`.
{% endcomment %}

<script
  src="{{ 'reveal-on-scroll.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<div class="policy-page-shell">
  <div class="policy-page page-width-content">
    <div class="policy-page__corner-bracket" aria-hidden="true"></div>
    <svg class="policy-page__circles" viewBox="0 0 200 200" fill="none" aria-hidden="true">
      <circle cx="130" cy="70" r="55" stroke="currentColor" stroke-width="0.5" />
      <circle cx="130" cy="70" r="75" stroke="currentColor" stroke-width="0.5" />
      <circle cx="130" cy="70" r="95" stroke="currentColor" stroke-width="0.5" />
    </svg>

    <reveal-on-scroll class="policy-page__intro">
      {% liquid
        assign policy_title = policy.title
        assign policy_eyebrow = section.settings.eyebrow
        case policy.title
          when 'Privacy policy'
            assign policy_title = 'מדיניות פרטיות'
            assign policy_eyebrow = 'מדיניות פרטיות'
          when 'Refund policy'
            assign policy_title = 'מדיניות החזרות'
            assign policy_eyebrow = 'Returns & Exchanges'
          when 'Shipping'
            assign policy_title = 'מדיניות משלוחים'
            assign policy_eyebrow = 'Shipping Policy'
          when 'Terms of service'
            assign policy_title = 'תנאי שימוש'
            assign policy_eyebrow = 'Terms of Use'
          when 'Legal notice'
            assign policy_title = 'הודעה משפטית'
            assign policy_eyebrow = 'Legal Notice'
          when 'Contact'
            assign policy_title = 'צרו קשר'
            assign policy_eyebrow = 'Contact'
        endcase
      %}
      {% if policy_eyebrow != blank %}
        <div class="policy-page__eyebrow">{{ policy_eyebrow }}</div>
      {% endif %}
      <h1 class="policy-page__title">{{ policy_title }}</h1>
      <div class="policy-page__divider" aria-hidden="true"><span></span><i></i><span></span></div>
    </reveal-on-scroll>

    <reveal-on-scroll class="policy-page__content">
      <rte-formatter>
        {{ policy.body }}
      </rte-formatter>
    </reveal-on-scroll>
  </div>
</div>

{% schema %}
{
  "name": "Policy",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Policy Document"
    }
  ]
}
{% endschema %}
