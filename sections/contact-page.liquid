

<script
  src="{{ 'reveal-on-scroll.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'contact-channel-reveal.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<div class="contact-page page-width-content">
  <reveal-on-scroll class="contact-page__intro">
    <p class="contact-page__intro-text">{{ section.settings.intro_text }}</p>
  </reveal-on-scroll>

  <div class="contact-page__grid">
    <reveal-on-scroll class="contact-page__form-card">
      {% if section.settings.form_heading != blank %}
        <h2 class="contact-page__card-heading">{{ section.settings.form_heading }}</h2>
      {% endif %}
      {% assign form_id = section.id | prepend: 'ContactPage-' %}
      {%- form 'contact', id: form_id, class: 'contact-page__form' -%}
        <input
          name="contact[id]"
          type="hidden"
          value="{{ form_id }}"
        >

        {% liquid
          assign form_matches = false
          if form.id == form_id or form.id == blank
            assign form_matches = true
          endif
        %}

        {%- if form.errors and form_matches -%}
          <div
            class="contact-page__message contact-page__message--error"
            tabindex="-1"
            autofocus
          >
            {{- 'icon-error.svg' | inline_asset_content -}}
            {{- form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email -}}
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? and form_matches -%}
          <div
            class="contact-page__message contact-page__message--success"
            tabindex="-1"
            autofocus
          >
            {{- 'icon-checkmark.svg' | inline_asset_content -}}
            {{- 'blocks.contact_form.post_success' | t -}}
          </div>
        {%- endif -%}

        <div class="contact-page__field-row">
          <div class="contact-page__field">
            <label for="ContactPage-name-{{ section.id }}">{{ section.settings.label_name }}</label>
            <input
              type="text"
              id="ContactPage-name-{{ section.id }}"
              autocomplete="name"
              name="contact[name]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            >
          </div>

          <div class="contact-page__field">
            <label for="ContactPage-email-{{ section.id }}">
              {{ section.settings.label_email }}
              <span aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="ContactPage-email-{{ section.id }}"
              autocomplete="email"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              {% if form.errors contains 'email' and form_matches %}
                aria-invalid="true"
              {% endif %}
              required
            >
          </div>
        </div>

        <div class="contact-page__field-row">
          <div class="contact-page__field">
            <label for="ContactPage-phone-{{ section.id }}">{{ section.settings.label_phone }}</label>
            <input
              type="tel"
              id="ContactPage-phone-{{ section.id }}"
              autocomplete="tel"
              name="contact[phone]"
              pattern="[0-9\-]*"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            >
          </div>

          <div class="contact-page__field">
            <label for="ContactPage-subject-{{ section.id }}">{{ section.settings.label_subject }}</label>
            <input
              type="text"
              id="ContactPage-subject-{{ section.id }}"
              name="contact[subject]"
            >
          </div>
        </div>

        <div class="contact-page__field">
          <label for="ContactPage-body-{{ section.id }}">{{ section.settings.label_message }}</label>
          <textarea
            rows="6"
            id="ContactPage-body-{{ section.id }}"
            name="contact[body]"
          >{{- form.body -}}</textarea>
        </div>

        <button
          type="submit"
          class="contact-page__submit"
        >
          {{ section.settings.label_submit }}
        </button>

        {% if section.settings.response_time != blank %}
          {%- comment -%}
            Sets the expectation before the visitor sends, so silence after
            submitting reads as normal rather than as a broken form.
          {%- endcomment -%}
          <p class="contact-page__response-time">{{ section.settings.response_time }}</p>
        {% endif %}
      {%- endform -%}
    </reveal-on-scroll>

    {%- comment -%}
      Three equal channel cards, one row, identical height. The previous
      version mixed a pill, two chips and a tall hours block on one line,
      which read as clutter rather than as a set of choices.
    {%- endcomment -%}
    <reveal-on-scroll class="contact-page__channels">
      {% if section.settings.whatsapp_number != blank %}
        {%- assign wa_digits = section.settings.whatsapp_number | remove: '-' | remove: ' ' | remove: '+' -%}
        <contact-channel-reveal class="contact-page__channel-wrap">
          <a
            class="contact-page__channel"
            href="https://wa.me/{{ wa_digits }}"
            target="_blank"
            rel="noopener"
          >
            <span class="contact-page__channel-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 0 1 8.24 8.24c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.43h-.47c-.16 0-.43.06-.65.31-.22.25-.85.84-.85 2.03 0 1.2.87 2.35.99 2.51.12.16 1.71 2.61 4.15 3.66.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"/>
              </svg>
            </span>
            <span class="contact-page__channel-label">{{ section.settings.whatsapp_label }}</span>
            <span class="contact-page__channel-value-wrap">
              <span class="contact-page__channel-value">{{ section.settings.whatsapp_number }}</span>
            </span>
          </a>
        </contact-channel-reveal>
      {% endif %}

      <contact-channel-reveal class="contact-page__channel-wrap">
        <a class="contact-page__channel" href="mailto:{{ section.settings.email }}">
          <span class="contact-page__channel-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="contact-page__channel-label">{{ section.settings.email_label }}</span>
          <span class="contact-page__channel-value-wrap">
            <span class="contact-page__channel-value">{{ section.settings.email }}</span>
          </span>
        </a>
      </contact-channel-reveal>

      <contact-channel-reveal class="contact-page__channel-wrap">
        <a class="contact-page__channel" href="tel:{{ section.settings.phone }}">
          <span class="contact-page__channel-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6.5 3.5c.7 0 1.3.4 1.6 1l1 2c.3.6.2 1.3-.3 1.8L7.5 9.6c1 2.4 2.9 4.3 5.3 5.3l1.3-1.3c.5-.5 1.2-.6 1.8-.3l2 1c.6.3 1 .9 1 1.6v1.7c0 1.2-1.1 2.1-2.3 1.9C10.9 18.7 5.3 13.1 4.4 6.4c-.2-1.2.7-2.3 1.9-2.3h.2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="contact-page__channel-label">{{ section.settings.phone_label }}</span>
          <span class="contact-page__channel-value-wrap">
            <span class="contact-page__channel-value">{{ section.settings.phone }}</span>
          </span>
        </a>
      </contact-channel-reveal>
    </reveal-on-scroll>

    <reveal-on-scroll class="contact-page__meta">
      <p class="contact-page__meta-line">
        {{ section.settings.hours_label }}: {{ section.settings.hours_days }}, {{ section.settings.hours_time }}
      </p>
      {% if section.settings.address != blank %}
        {%- comment -%}
          Google's Hebrew-text geocoder can't resolve this address and falls
          back to an unrelated keyword search. The address IS indexed, but
          only under its Latin transliteration ("Derekh ha-Rimonim 29,
          Rinatya"). map_coordinates pins that exact resolved point instead
          of relying on live text geocoding.
        {%- endcomment -%}
        {% assign maps_query = section.settings.map_coordinates | default: section.settings.address | url_encode %}
        <p class="contact-page__meta-line">
          <a
            href="https://www.google.com/maps/search/?api=1&query={{ maps_query }}"
            target="_blank"
            rel="noopener"
            class="contact-page__map-link"
          >
            {{ section.settings.address }}
          </a>
        </p>
      {% endif %}
    </reveal-on-scroll>

    {% if section.settings.address != blank %}
      <reveal-on-scroll class="contact-page__map">
        <iframe
          src="https://www.google.com/maps?q={{ maps_query }}&z=17&output=embed"
          width="100%"
          height="240"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="{{ shop.name }} על המפה"
        ></iframe>
      </reveal-on-scroll>
    {% endif %}
  </div>

  <reveal-on-scroll class="contact-page__footer">
    <p>{{ section.settings.footer_message }}</p>
  </reveal-on-scroll>
</div>

{% stylesheet %}
  .contact-page__card-heading {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 1.25rem;
    color: #1a1a2e;
    margin: 0 0 24px;
  }

  .contact-page__whatsapp {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-radius: 999px;
    background-color: #1a1a2e;
    color: #ffffff;
    text-decoration: none;
    font-size: 1rem;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }

  .contact-page__whatsapp:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(26, 26, 46, 0.18);
  }

  .contact-page__whatsapp .contact-page__info-icon svg {
    width: 22px;
    height: 22px;
  }

  .contact-page__response-time {
    margin: 0;
    font-size: 0.875rem;
    color: #5a554d;
    text-align: center;
  }

  .contact-page__info-row--address span {
    line-height: 1.5;
  }

  .contact-page {
    padding-block: 24px 96px;
  }

  .contact-page__intro {
    display: block;
    text-align: center;
    margin-block-end: 56px;
  }

  .contact-page__intro-text {
    font-family: var(--font-body--family);
    font-size: 1.2rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / 70%);
    max-width: 34rem;
    margin-inline: auto;
  }

  /* Single vertical flow: contact channels first as a compact strip, then the
     form centred at reading width. The old two-column split forced the eye to
     choose between two competing bodies of content at the same weight. */
  .contact-page__grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  .contact-page__channels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    width: 100%;
    max-width: 56rem;
    order: -2;
  }

  .contact-page__channel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    text-decoration: none;
    padding: 24px 20px;
    border-radius: 20px;
    background-color: #ffffff;
    border: 1px solid rgb(var(--color-foreground-rgb) / 8%);
    color: #1a1a2e;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }

  .contact-page__channel:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(26, 26, 46, 0.12);
  }

  .contact-page__channel--primary {
    background-color: #1a1a2e;
    border-color: #1a1a2e;
    color: #ffffff;
  }

  .contact-page__channel-icon svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  .contact-page__channel-label {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    opacity: 0.65;
  }

  .contact-page__channel-value {
    display: inline-block;
    font-size: 1.05rem;
    direction: ltr;
  }

  .contact-page__channel--primary .contact-page__channel-value {
    color: #ffffff;
  }

  /* Wrapper carries the click-to-reveal state without affecting grid layout. */
  .contact-page__channel-wrap {
    display: contents;
  }

  /* Collapsed by default so the card shows only its label. Clicking the card
     reveals the value by expanding the wrapper open and fading/sliding the
     text in, rather than just unblurring text that was already in place. */
  .contact-page__channel-value-wrap {
    display: block;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease;
  }

  .contact-page__channel-value-wrap .contact-page__channel-value {
    transform: translateY(-6px);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  contact-channel-reveal.is-revealed .contact-page__channel-value-wrap {
    max-height: 2.5rem;
    opacity: 1;
  }

  contact-channel-reveal.is-revealed .contact-page__channel-value-wrap .contact-page__channel-value {
    transform: translateY(0);
  }

  .contact-page__meta {
    display: block;
    order: -1;
    text-align: center;
  }

  .contact-page__meta-line {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
    color: rgb(var(--color-foreground-rgb) / 60%);
  }

  .contact-page__map-link {
    color: inherit;
    text-decoration: none;
  }

  .contact-page__map-link:hover {
    text-decoration: underline;
  }

  .contact-page__map {
    order: -1;
    width: 100%;
    max-width: 56rem;
    border-radius: 20px;
    overflow: hidden;
  }

  .contact-page__map iframe {
    display: block;
  }

  .contact-page__form-card {
    width: 100%;
    max-width: 44rem;
    margin-block-start: 20px;
  }

  @media screen and (max-width: 749px) {
    .contact-page__grid {
      gap: 32px;
    }

    .contact-page__channels {
      grid-template-columns: 1fr;
    }

    .contact-page__channel {
      flex-direction: row;
      justify-content: center;
      gap: 10px;
      padding: 16px 20px;
    }

    .contact-page__channel-label {
      display: none;
    }
  }

  .contact-page__form-card {
    display: block;
    background-color: #ffffff;
    border-radius: 24px;
    box-shadow: 0 2px 8px rgba(26, 26, 46, 0.06), 0 16px 40px rgba(26, 26, 46, 0.08);
    padding: 40px;
  }

  @media screen and (max-width: 749px) {
    .contact-page__form-card {
      padding: 28px 24px;
    }
  }

  .contact-page__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-page__field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  @media screen and (max-width: 549px) {
    .contact-page__field-row {
      grid-template-columns: 1fr;
    }
  }

  .contact-page__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .contact-page__field label {
    font-size: 0.9rem;
    color: rgb(var(--color-foreground-rgb) / 65%);
  }

  .contact-page__field input,
  .contact-page__field textarea {
    font-family: var(--font-body--family);
    font-size: 1rem;
    padding: 14px 18px;
    border-radius: 14px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 15%);
    background-color: #ffffff;
    color: var(--color-foreground);
    transition: border-color 0.25s ease-in-out, box-shadow 0.25s ease-in-out;
  }

  .contact-page__field textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .contact-page__field input:focus,
  .contact-page__field textarea:focus {
    outline: none;
    border-color: #1a1a2e;
    box-shadow: 0 0 0 3px rgba(26, 26, 46, 0.1);
  }

  .contact-page__submit {
    align-self: flex-end;
    font-family: var(--font-body--family);
    font-size: 1rem;
    color: #ffffff;
    background-color: #1a1a2e;
    border: 1px solid #1a1a2e;
    border-radius: 999px;
    padding: 14px 32px;
    cursor: pointer;
    transition: transform 0.3s ease-in-out, background-color 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
  }

  .contact-page__submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(26, 26, 46, 0.2);
  }

  .contact-page__message {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-radius: 14px;
    font-size: 0.95rem;
  }

  .contact-page__message--success {
    background-color: rgba(70, 140, 100, 0.1);
    color: #2f6b47;
  }

  .contact-page__message--error {
    background-color: rgba(180, 60, 60, 0.08);
    color: #a13a3a;
  }

  .contact-page__info-row {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1rem;
  }

  .contact-page__info-row a {
    color: var(--color-foreground);
    text-decoration: none;
  }

  .contact-page__info-row a:hover {
    text-decoration: underline;
  }

  .contact-page__info-icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: #ffffff;
    color: #1a1a2e;
  }

  .contact-page__info-icon svg {
    width: 18px;
    height: 18px;
  }

  .contact-page__divider {
    height: 1px;
    background-color: rgb(var(--color-foreground-rgb) / 12%);
  }

  .contact-page__hours {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .contact-page__hours-days,
  .contact-page__hours-time {
    margin: 0;
    padding-inline-start: 52px;
    color: rgb(var(--color-foreground-rgb) / 70%);
    font-size: 0.95rem;
  }

  .contact-page__footer {
    display: block;
    text-align: center;
    margin-block-start: 72px;
  }

  .contact-page__footer p {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 1.35rem;
    line-height: 1.6;
    color: #1a1a2e;
    max-width: 36rem;
    margin-inline: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .contact-page reveal-on-scroll.is-observing {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .contact-page reveal-on-scroll.is-observing.is-revealed {
      opacity: 1;
      transform: translateY(0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact page",
  "settings": [
    {
      "type": "text",
      "id": "intro_text",
      "label": "Intro text",
      "default": "נשמח לעזור בכל שאלה, בקשה או התייעצות."
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form card heading",
      "default": "שלחו לנו הודעה"
    },
    {
      "type": "text",
      "id": "info_heading",
      "label": "Info card heading",
      "default": "פרטי התקשרות"
    },
    {
      "type": "text",
      "id": "response_time",
      "label": "Response time note",
      "default": "נחזור אליכם תוך יום עסקים אחד."
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number (international format)",
      "default": "972545696909"
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "WhatsApp button label",
      "default": "וואטסאפ"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "דרך הרימונים 29, מושב רינתיה, 7316500, ישראל"
    },
    {
      "type": "text",
      "id": "map_coordinates",
      "label": "Map pin coordinates (lat,lng)",
      "info": "Google's Hebrew geocoder can't resolve this street directly, but it is indexed under the Latin transliteration \"Derekh ha-Rimonim 29, Rinatya\". This is that exact resolved point. Leave as-is unless the business moves.",
      "default": "32.0433535,34.9305696"
    },
    {
      "type": "text",
      "id": "label_name",
      "label": "Name field label",
      "default": "שם מלא"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Email field label",
      "default": "כתובת אימייל"
    },
    {
      "type": "text",
      "id": "label_phone",
      "label": "Phone field label",
      "default": "טלפון (אופציונלי)"
    },
    {
      "type": "text",
