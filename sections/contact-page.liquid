{{ 'contact-page-styles.css' | asset_url | stylesheet_tag }}
<script
  src="{{ 'reveal-on-scroll.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'contact-channel-reveal.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- comment -%}
  Phone/address fall back to Settings > General store details (the shop
  object) instead of a second hardcoded copy in this section's settings, so
  they can never drift out of sync with the real business record.
{%- endcomment -%}
{%- assign contact_phone_digits = shop.address.phone | remove: '-' | remove: ' ' -%}
{%- assign contact_phone_p1 = contact_phone_digits | slice: 0, 3 -%}
{%- assign contact_phone_p2 = contact_phone_digits | slice: 3, 3 -%}
{%- assign contact_phone_p3 = contact_phone_digits | slice: 6, 4 -%}
{%- assign contact_phone_formatted = contact_phone_p1
  | append: '-'
  | append: contact_phone_p2
  | append: '-'
  | append: contact_phone_p3
-%}
{%- assign effective_phone = section.settings.phone | default: contact_phone_formatted -%}
{%- assign contact_phone_local = contact_phone_digits | remove_first: '0' -%}
{%- assign contact_phone_intl = contact_phone_local | prepend: '972' -%}
{%- assign effective_whatsapp = section.settings.whatsapp_number | default: contact_phone_intl -%}
{%- comment -%}
  Order matches the required address format and the footer
  (blocks/footer-copyright.liquid): address line, city, area/district,
  postcode, country. Israel has no formal province field, so the
  district is a literal; country is appended last.
{%- endcomment -%}
{%- assign effective_address = section.settings.address
  | default: shop.address.address1
  | append: ', '
  | append: shop.address.city
  | append: ', '
  | append: 'מחוז המרכז'
  | append: ', '
  | append: shop.address.zip
  | append: ', '
  | append: shop.address.country
-%}
{%- assign effective_email = section.settings.email | default: shop.email -%}

<div class="contact-page page-width-content">
  <reveal-on-scroll class="contact-page__intro">
    <p class="contact-page__intro-text">{{ section.settings.intro_text }}</p>
  </reveal-on-scroll>

  <div class="contact-page__grid">
    <reveal-on-scroll class="contact-page__form-card">
      {% if section.settings.form_heading != blank %}
        <h2 class="contact-page__card-heading">{{ section.settings.form_heading }}</h2>
      {% endif %}
      {% assign form_id = section.id | prepend: 'ContactPage-' %}
      {%- form 'contact', id: form_id, class: 'contact-page__form' -%}
        <input
          name="contact[id]"
          type="hidden"
          value="{{ form_id }}"
        >

        {% liquid
          assign form_matches = false
          if form.id == form_id or form.id == blank
            assign form_matches = true
          endif
        %}

        {%- if form.errors and form_matches -%}
          <div
            class="contact-page__message contact-page__message--error"
            tabindex="-1"
            autofocus
          >
            {{- 'icon-error.svg' | inline_asset_content -}}
            {{- form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email -}}
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? and form_matches -%}
          <div
            class="contact-page__message contact-page__message--success"
            tabindex="-1"
            autofocus
          >
            {{- 'icon-checkmark.svg' | inline_asset_content -}}
            {{- 'blocks.contact_form.post_success' | t -}}
          </div>
        {%- endif -%}

        <div class="contact-page__field-row">
          <div class="contact-page__field">
            <label for="ContactPage-name-{{ section.id }}">{{ section.settings.label_name }}</label>
            <input
              type="text"
              id="ContactPage-name-{{ section.id }}"
              autocomplete="name"
              name="contact[name]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            >
          </div>

          <div class="contact-page__field">
            <label for="ContactPage-email-{{ section.id }}">
              {{ section.settings.label_email }}
              <span aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="ContactPage-email-{{ section.id }}"
              autocomplete="email"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              {% if form.errors contains 'email' and form_matches %}
                aria-invalid="true"
              {% endif %}
              required
            >
          </div>
        </div>

        <div class="contact-page__field-row">
          <div class="contact-page__field">
            <label for="ContactPage-phone-{{ section.id }}">{{ section.settings.label_phone }}</label>
            <input
              type="tel"
              id="ContactPage-phone-{{ section.id }}"
              autocomplete="tel"
              name="contact[phone]"
              pattern="[0-9\-]*"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            >
          </div>

          <div class="contact-page__field">
            <label for="ContactPage-subject-{{ section.id }}">{{ section.settings.label_subject }}</label>
            <input
              type="text"
              id="ContactPage-subject-{{ section.id }}"
              name="contact[subject]"
            >
          </div>
        </div>

        <div class="contact-page__field">
          <label for="ContactPage-body-{{ section.id }}">{{ section.settings.label_message }}</label>
          <textarea
            rows="6"
            id="ContactPage-body-{{ section.id }}"
            name="contact[body]"
          >{{- form.body -}}</textarea>
        </div>

        <button
          type="submit"
          class="contact-page__submit"
        >
          {{ section.settings.label_submit }}
        </button>

        {% if section.settings.response_time != blank %}
          {%- comment -%}
            Sets the expectation before the visitor sends, so silence after
            submitting reads as normal rather than as a broken form.
          {%- endcomment -%}
          <p class="contact-page__response-time">{{ section.settings.response_time }}</p>
        {% endif %}
      {%- endform -%}
    </reveal-on-scroll>

    {%- comment -%}
      Three equal channel cards, one row, identical height. The previous
      version mixed a pill, two chips and a tall hours block on one line,
      which read as clutter rather than as a set of choices.
    {%- endcomment -%}
    <reveal-on-scroll class="contact-page__channels">
      {% if effective_whatsapp != blank %}
        {%- assign wa_digits = effective_whatsapp | remove: '-' | remove: ' ' | remove: '+' -%}
        {%- comment -%}
          data-open-on-reveal: unlike phone (below), the first click both
          reveals the "שלח הודעה" label AND lets the browser follow the
          link, opening wa.me - it routes to the WhatsApp app on mobile and
          WhatsApp Web/Desktop on desktop automatically.
        {%- endcomment -%}
        <contact-channel-reveal class="contact-page__channel-wrap" data-open-on-reveal>
          <a
            class="contact-page__channel"
            href="https://wa.me/{{ wa_digits }}"
            target="_blank"
            rel="noopener"
          >
            <span class="contact-page__channel-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 0 1 8.24 8.24c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.43h-.47c-.16 0-.43.06-.65.31-.22.25-.85.84-.85 2.03 0 1.2.87 2.35.99 2.51.12.16 1.71 2.61 4.15 3.66.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"/>
              </svg>
            </span>
            <span class="contact-page__channel-label">{{ section.settings.whatsapp_label }}</span>
            <span class="contact-page__channel-value-wrap">
              <span class="contact-page__channel-value">שלח הודעה</span>
            </span>
          </a>
        </contact-channel-reveal>
      {% endif %}

      {%- comment -%}
        data-open-on-reveal here too: click reveals "שלח מייל" and opens the
        visitor's email client via mailto:, in one action.
      {%- endcomment -%}
      {%- comment -%}
        mailto: links depend on the visitor having a default mail client
        configured, which often silently does nothing - so this stays
        reveal-only like phone, showing the actual address to copy instead
        of a "send" action that can appear broken.
      {%- endcomment -%}
      <contact-channel-reveal class="contact-page__channel-wrap is-revealed">
<div class="contact-page__channel"><a class="contact-page__channel-icon-link" href="mailto:{{ effective_email }}" aria-label="{{ section.settings.email_label }}"><span class="contact-page__channel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="contact-page__channel-label">{{ section.settings.email_label }}</span></a><span class="contact-page__channel-value">{{ effective_email }}</span></div>
      </contact-channel-reveal>

      <contact-channel-reveal class="contact-page__channel-wrap is-revealed">
<div class="contact-page__channel"><a class="contact-page__channel-icon-link" href="tel:{{ effective_phone }}" aria-label="{{ section.settings.phone_label }}"><span class="contact-page__channel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.5 3.5c.7 0 1.3.4 1.6 1l1 2c.3.6.2 1.3-.3 1.8L7.5 9.6c1 2.4 2.9 4.3 5.3 5.3l1.3-1.3c.5-.5 1.2-.6 1.8-.3l2 1c.6.3 1 .9 1 1.6v1.7c0 1.2-1.1 2.1-2.3 1.9C10.9 18.7 5.3 13.1 4.4 6.4c-.2-1.2.7-2.3 1.9-2.3h.2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></span><span class="contact-page__channel-label">{{ section.settings.phone_label }}</span></a><span class="contact-page__channel-value">{{ effective_phone }}</span></div> 
      </contact-channel-reveal>
    </reveal-on-scroll>

    <reveal-on-scroll class="contact-page__meta">
      <p class="contact-page__meta-line">
        {{ section.settings.hours_label }}: {{ section.settings.hours_days }}, {{ section.settings.hours_time }}
      </p>
      {% if effective_address != blank %}
        {%- comment -%}
          Google's Hebrew-text geocoder can't resolve this address and falls
          back to an unrelated keyword search. The address IS indexed, but
          only under its Latin transliteration ("Derekh ha-Rimonim 29,
          Rinatya"). map_coordinates pins that exact resolved point instead
          of relying on live text geocoding.
        {%- endcomment -%}
        {% assign maps_query = section.settings.map_coordinates | default: effective_address | url_encode %}
        <p class="contact-page__meta-line contact-page__address">
                      <span class="contact-page__address-text">{{ effective_address }}</span>
                                  <a
                                                href="https://www.google.com/maps/search/?api=1&query={{ maps_query }}"
                                                              target="_blank"
                                                                            rel="noopener"
                                                                                          class="contact-page__map-link contact-page__map-link--small"
                                                                                                      >(פתח במפות)</a>
                                                                                                    </p>
      {% endif %}
      {% if section.settings.business_identity != blank %}
        <p class="contact-page__meta-line contact-page__meta-line--muted">
          {{ section.settings.business_identity }}
        </p>
      {% endif %}
    <p class="contact-page__meta-line">        <a href="/pages/faq" class="contact-page__map-link">שאלות נפוצות</a>
        </p>
    </reveal-on-scroll>

    {% if effective_address != blank %}
      <reveal-on-scroll class="contact-page__map">
        <iframe
          src="https://www.google.com/maps?q={{ maps_query }}&z=17&output=embed"
          width="100%"
          height="240"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="{{ shop.name }} על המפה"
        ></iframe>
      </reveal-on-scroll>
    {% endif %}
  </div>

  <reveal-on-scroll class="contact-page__footer">
    <p>{{ section.settings.footer_message }}</p>
  </reveal-on-scroll>
</div>



{% schema %}
{
  "name": "Contact page",
  "settings": [
    {
      "type": "text",
      "id": "intro_text",
      "label": "Intro text",
      "default": "נשמח לעזור בכל שאלה, בקשה או התייעצות."
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form card heading",
      "default": "שלחו לנו הודעה"
    },
    {
      "type": "text",
      "id": "info_heading",
      "label": "Info card heading",
      "default": "פרטי התקשרות"
    },
    {
      "type": "text",
      "id": "response_time",
      "label": "Response time note",
      "default": "נחזור אליכם תוך יום עסקים אחד."
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number (international format)",
      "info": "Leave blank to derive from Settings > General store details automatically"
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "WhatsApp button label",
      "default": "וואטסאפ"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "info": "Leave blank to use Settings > General store details automatically"
    },
    {
      "type": "text",
      "id": "map_coordinates",
      "label": "Map pin coordinates (lat,lng)",
      "info": "Google's Hebrew geocoder can't resolve this street directly, but it is indexed under the Latin transliteration \"Derekh ha-Rimonim 29, Rinatya\". This is that exact resolved point. Leave as-is unless the business moves.",
      "default": "32.0433535,34.9305696"
    },
    {
      "type": "text",
      "id": "label_name",
      "label": "Name field label",
      "default": "שם מלא"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Email field label",
      "default": "כתובת אימייל"
    },
    {
      "type": "text",
      "id": "label_phone",
      "label": "Phone field label",
      "default": "טלפון (אופציונלי)"
    },
    {
      "type": "text",
      "id": "label_subject",
      "label": "Subject field label",
      "default": "נושא"
    },
    {
      "type": "text",
      "id": "label_message",
      "label": "Message field label",
      "default": "הודעה"
    },
    {
      "type": "text",
      "id": "label_submit",
      "label": "Submit button label",
      "default": "שלחו הודעה"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email channel label",
      "default": "אימייל"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone channel label",
      "default": "טלפון"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Contact email",
      "info": "Leave blank to use Settings > General store details automatically"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Contact phone",
      "info": "Leave blank to use Settings > General store details automatically"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Hours label",
      "default": "שעות פעילות"
    },
    {
      "type": "text",
      "id": "hours_days",
      "label": "Hours days",
      "default": "ימים א׳-ה׳"
    },
    {
      "type": "text",
      "id": "hours_time",
      "label": "Hours time",
      "default": "09:00-18:00, ובימי שישי עד השעה 16:00"
    },
    {
      "type": "textarea",
      "id": "footer_message",
      "label": "Footer message",
      "default": "אנחנו מאמינים שכל בית ראוי לעיצוב איכותי שמכניס אווירה, חמימות ונגיעה עתידנית לחלל."
    },
    {
      "type": "text",
      "id": "business_identity",
      "label": "Business identity note",
      "info": "Shown under the address. Google's Misrepresentation policy expects the registered trading entity to be disclosed here too.",
      "default": "תמונה לבית הוא מיזם של דניאל אמינוב וזרמן איסקוב, פועל תחת עוסק מורשה 306082793 (דניאל פיקס)"
    }
  ],
  "presets": [
    {
      "name": "Contact page"
    }
  ]
}
{% endschema %}