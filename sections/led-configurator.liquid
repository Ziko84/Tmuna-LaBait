{%- comment -%}
  Custom product experience for the LED wall-art line.

  Renders a reactive day/lit preview plus a quiet, boutique option stack:
  - מידה (size)  -> maps to product option 1
  - תאורת לד (LED) -> maps to product option 2, drives price and the preview
  - גוון (frame color) -> a made-to-order line-item property, NOT a variant,
    so the Merchant feed stays one honest offer per size+LED (no white photo
    we do not have).

  Image convention: product media position 1 = off (no LED, the default view),
  position 2 = lit (warm on). Single/multi are hue treatments of the lit shot.

  Scoped to products on the "led" template suffix, so it can be rolled out one
  product at a time without touching the rest of the catalogue.
{%- endcomment -%}

{%- assign v0 = product.selected_or_first_available_variant -%}
{%- assign img_off = product.media[0] -%}
{%- assign img_lit = product.media[1] | default: product.media[0] -%}

<div class="lc" dir="rtl">
  <div class="section section--page-width lc__wrap">
  <div class="lc__grid">

    <div class="lc__media">
      <div class="lc__preview" id="lc-preview">
        {%- if img_off -%}
          {%- assign img_off_alt = img_off.alt | default: product.title -%}
          <img class="lc__layer lc__layer--day" src="{{ img_off.preview_image | image_url: width: 1000, quality: 65 }}" alt="{{ img_off_alt | escape }}">
        {%- endif -%}
        {%- if img_lit -%}
          {%- if img_lit.alt != blank -%}
            {%- assign img_lit_alt = img_lit.alt -%}
          {%- else -%}
            {%- assign img_lit_alt = product.title | append: ' מואר' -%}
          {%- endif -%}
          <img class="lc__layer lc__layer--night" src="{{ img_lit.preview_image | image_url: width: 1000, quality: 65 }}" alt="{{ img_lit_alt | escape }}">
        {%- endif -%}
        <span class="lc__pstate" id="lc-pstate"></span>
      </div>
    </div>

    <div class="lc__col">
      <h1 class="lc__name">{{ product.title }}</h1>
      <p class="lc__price" id="lc-price">{{ v0.price | money }}</p>

      <div class="lc__rule"></div>

      {%- form 'product', product, id: 'lc-form', class: 'lc__form' -%}
        <input type="hidden" name="id" id="lc-variant-id" value="{{ v0.id }}">
        <input type="hidden" name="properties[גוון]" id="lc-color" value="שחור">

        {%- comment -%} Frame color: made-to-order property, quiet pills {%- endcomment -%}
        <div class="lc__field">
          <div class="lc__label">גוון היצירה</div>
          <div class="lc__pills" id="lc-colors">
            <button type="button" class="lc__pill" data-color="שחור" aria-pressed="true"><span class="lc__dot lc__dot--black"></span>שחור</button>
            <button type="button" class="lc__pill" data-color="לבן" aria-pressed="false"><span class="lc__dot lc__dot--white"></span>לבן</button>
            <button type="button" class="lc__pill" data-color="עץ" aria-pressed="false"><span class="lc__dot lc__dot--wood"></span>עץ</button>
          </div>
          <p class="lc__note">מיוצר לפי הזמנה בגוון שתבחרו. אינו משנה את המחיר.</p>
        </div>

        {%- comment -%} Size: pills from product option 1 {%- endcomment -%}
        {%- for opt in product.options_with_values -%}
          {%- if opt.name == 'מידה' -%}
            <div class="lc__field">
              <div class="lc__label">מידה</div>
              <div class="lc__pills lc__pills--size" id="lc-sizes">
                {%- for val in opt.values -%}
                  {%- assign short = val -%}
                  {%- case val -%}
                    {%- when 'קטן - 50x50' -%}{%- assign short = '50×50' -%}
                    {%- when 'בינוני - 70x70' -%}{%- assign short = '70×70' -%}
                    {%- when 'גדול - 90x90' -%}{%- assign short = '90×90' -%}
                    {%- when 'התאמה אישית - עד 120x120' -%}{%- assign short = 'אישית' -%}
                  {%- endcase -%}
                  <button type="button" class="lc__pill" data-size="{{ val | escape }}" aria-pressed="{% if val == opt.selected_value %}true{% else %}false{% endif %}">{{ short }}</button>
                {%- endfor -%}
              </div>
              <div class="lc__noled" id="lc-noled"><b>שימו לב</b> מידה זו מגיעה ללא אפשרות תאורת לד.</div>
              <div class="lc__custom" id="lc-custom" hidden>
                <div class="lc__custom-row">
                  <label>רוחב<input type="number" min="10" max="120" id="lc-w" placeholder="ס״מ" inputmode="numeric"></label>
                  <span class="lc__custom-x">×</span>
                  <label>גובה<input type="number" min="10" max="120" id="lc-h" placeholder="ס״מ" inputmode="numeric"></label>
                </div>
                <p class="lc__note">המידות לבחירתכם, עד 120 ס״מ בכל צד.</p>
              </div>
              <input type="hidden" name="properties[מידות מבוקשות]" id="lc-dims" disabled>
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} LED: quiet collapsing panel, values from product option 2 {%- endcomment -%}
        {%- for opt in product.options_with_values -%}
          {%- if opt.name == 'תאורת לד' -%}
            <div class="lc__field" id="lc-ledfield">
              <div class="lc__led" id="lc-led">
                <button type="button" class="lc__led-head" id="lc-led-head">
                  <span class="lc__led-title"><span class="lc__spark"></span>תאורת לד</span>
                  <span class="lc__led-cur"><span id="lc-led-cur">ללא תאורה</span><span class="lc__chev">▾</span></span>
                </button>
                <div class="lc__led-body"><div class="lc__led-inner"><div class="lc__led-opts" id="lc-led-opts">
                  {%- for val in opt.values -%}
                    {%- assign desc = '' -%}
                    {%- assign mode = '' -%}
                    {%- case val -%}
                      {%- when 'ללא תאורה' -%}{%- assign desc = 'היצירה נטו, בעיצוב נקי' -%}{%- assign mode = '' -%}
                      {%- when 'לבן חם' -%}{%- assign desc = 'אור צהבהב רך ואחיד' -%}{%- assign mode = 'lit' -%}
                      {%- when 'צבע יחיד' -%}{%- assign desc = 'כל צבע שתרצו, מתחלף בשלט. צבע אחד בכל רגע' -%}{%- assign mode = 'lit single' -%}
                      {%- when 'רב-צבע' -%}{%- assign desc = 'כל הצבעים יחד ואפקטים, המרשים ביותר. כולל שלט' -%}{%- assign mode = 'lit multi' -%}
                    {%- endcase -%}
                    <button type="button" class="lc__tier" data-led="{{ val | escape }}" data-mode="{{ mode }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                      <span class="lc__check">✓</span>
                      <span class="lc__tier-txt"><b>{{ val }}</b><span>{{ desc }}</span></span>
                      <span class="lc__tier-price" data-role="delta"></span>
                    </button>
                  {%- endfor -%}
                </div></div></div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}

        <button type="submit" name="add" class="lc__atc">הוספה לסל</button>
      {%- endform -%}

      {%- comment -%}
        No description on the buy side. It reads as clutter next to the
        choices; the full text lives in the "על היצירה" card below, which is
        where the rest of the store keeps it too. This card is for choosing.
      {%- endcomment -%}

      {%- comment -%} Trust row, matching the rest of the store's product pages {%- endcomment -%}
      <div class="lc__trust">
        <div class="lc__trust-item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
          <span>תשלום מאובטח</span>
        </div>
        <div class="lc__trust-item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.6"/><path d="M18 4v3h-3"/></svg>
          <span>החזרה חינם תוך 14 יום</span>
        </div>
        <div class="lc__trust-item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
          <span>משלוח מהיר</span>
        </div>
      </div>
    </div>
  </div>
  </div>

  {%- comment -%} Full description in its own card below, matching every other product page {%- endcomment -%}
  {% render 'product-info-panel', product: product %}

  <script type="application/json" id="lc-variants">
    [{% for v in product.variants %}{"id":{{ v.id }},"size":{{ v.option1 | json }},"led":{{ v.option2 | json }},"price":{{ v.price }},"available":{{ v.available }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
  </script>

  {%- comment -%}
    Product structured data. The custom template replaces Shopify's default
    product-information section, which had emitted the ProductGroup JSON-LD;
    this restores it so product pages keep price/availability/brand in rich
    results and stay legible to AI shopping assistants. One Offer per variant
    (Size x LED). URLs are normalised to absolute because image_url may return
    a protocol-relative //cdn URL.
  {%- endcomment -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "ProductGroup",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | strip_newlines | truncate: 400 | json }},
    "brand": { "@type": "Brand", "name": "תמונה לבית" },
    "productGroupID": {{ product.id | json }},
    "url": {{ product.url | prepend: shop.url | json }},
    "variesBy": ["https://schema.org/size", "https://schema.org/pattern"],
    "image": [
      {%- assign _ld_imgs = product.media | where: 'media_type', 'image' -%}
      {%- for m in _ld_imgs limit: 5 -%}
        {%- capture _u -%}{{ m.preview_image | image_url: width: 1400 }}{%- endcapture -%}
        {%- if _u contains '://' -%}{%- assign _abs = _u -%}{%- else -%}{%- assign _abs = _u | prepend: 'https:' -%}{%- endif -%}
        {{ _abs | json }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    "hasVariant": [
      {%- for v in product.variants -%}
        {%- assign _vimg = v.image | default: product.featured_media.preview_image -%}
        {%- capture _vu -%}{{ _vimg | image_url: width: 1200 }}{%- endcapture -%}
        {%- if _vu contains '://' -%}{%- assign _vabs = _vu -%}{%- else -%}{%- assign _vabs = _vu | prepend: 'https:' -%}{%- endif -%}
        {%- comment -%} Flat shipping rate of 45 ILS on every order, no free-shipping threshold. {%- endcomment -%}
        {%- assign _ship = '45' -%}
        {
          "@type": "Product",
          "name": {{ v.title | prepend: ' - ' | prepend: product.title | json }},
          "description": {{ product.description | strip_html | strip_newlines | truncate: 300 | json }},
          "size": {{ v.option1 | json }},
          "pattern": {{ v.option2 | json }},
          "sku": {{ v.sku | json }},
          "image": {{ _vabs | json }},
          "offers": {
            "@type": "Offer",
            "price": "{{ v.price | divided_by: 100.0 }}",
            "priceCurrency": {{ shop.currency | json }},
            "availability": "https://schema.org/InStock",
            "url": {{ v.url | prepend: shop.url | json }},
            "hasMerchantReturnPolicy": {
              "@type": "MerchantReturnPolicy",
              "applicableCountry": "IL",
              "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
              "merchantReturnDays": 14,
              "returnMethod": "https://schema.org/ReturnByMail",
              "returnFees": "https://schema.org/FreeReturn"
            },
            "shippingDetails": {
              "@type": "OfferShippingDetails",
              "shippingRate": { "@type": "MonetaryAmount", "value": "{{ _ship }}", "currency": "ILS" },
              "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "IL" },
              {%- comment -%} Matches GMC shipping settings: same business day handling, 3-5 business day transit. {%- endcomment -%}
              "deliveryTime": {
                "@type": "ShippingDeliveryTime",
                "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 0, "unitCode": "DAY" },
                "transitTime": { "@type": "QuantitativeValue", "minValue": 3, "maxValue": 5, "unitCode": "DAY" }
              }
            }
          }
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>
</div>

{% render 'sticky-add-to-cart' %}

{%- comment -%}
  The shared sticky-add-to-cart component only activates itself against the
  theme's standard <product-form-component>/.buy-buttons-block markup, which
  this section doesn't use (its size/LED-tier picker is fully custom, driven
  by data-led/data-mode buttons rather than the standard variant-picker
  inputs the component listens for). Left alone, the bar would stay
  permanently hidden and, if forced visible, its own click handler would add
  whatever variant was selected on page load rather than the customer's
  actual current choice.

  This script does two things instead, both scoped to this section only:
  1. Toggles the bar's existing data-stuck attribute (the CSS that shows/
     hides it already keys off this) based on whether the real .lc__atc
     button has scrolled out of view - the same visibility rule the shared
     component uses, just driven independently.
  2. Makes the sticky bar's own button a pure proxy for the real .lc__atc
     submit button instead of using the shared component's own add-to-cart
     logic, so it always submits whatever size/LED/color is actually
     selected right now, never a stale snapshot.
{%- endcomment -%}
<script>
  (function () {
    function init() {
      var realButton = document.querySelector('.lc__atc');
      var stickyBar = document.querySelector('.sticky-add-to-cart__bar');
      var stickyButton = stickyBar ? stickyBar.querySelector('[ref="addToCartButton"]') : null;
      if (!realButton || !stickyBar || !stickyButton) return;

      stickyButton.addEventListener(
        'click',
        function (event) {
          event.preventDefault();
          event.stopImmediatePropagation();
          realButton.click();
        },
        true
      );

      var footer = document.querySelector('footer') || document.querySelector('[class*="footer-group"]');
      var footerVisible = false;

      var buttonObserver = new IntersectionObserver(function (entries) {
        var entry = entries[0];
        if (!entry) return;
        var scrolledPast = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        stickyBar.setAttribute('data-stuck', scrolledPast && !footerVisible ? 'true' : 'false');
      });
      buttonObserver.observe(realButton);

      if (footer) {
        var footerObserver = new IntersectionObserver(function (entries) {
          var entry = entries[0];
          if (!entry) return;
          footerVisible = entry.isIntersecting;
          if (footerVisible) stickyBar.setAttribute('data-stuck', 'false');
        });
        footerObserver.observe(footer);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

{% stylesheet %}
  .lc{--ink:#1a1a2e;--bronze:#8a6e46;--bronze-tint:rgba(138,110,70,.08);--cream:#f7f5f2;--line:#e8e3d9;--line-soft:#efeadf;--muted:#6d685f;--up:#d93025;--down:#1e8e3e;font-weight:300;color:var(--ink)}
  /* Match the store's product layout: the whole thing sits in a cream
     floating card (radius 32, soft shadow, 32px padding) like every other
     product page. Inside: image LEFT, details RIGHT, ~1.5:1, square 1:1
     frame. Grid is ltr so the first child (media) lands left; children stay
     rtl for text. */
  .lc__grid{display:grid;grid-template-columns:minmax(0,1.32fr) minmax(320px,1fr);gap:40px;align-items:start;direction:ltr;width:100%;
    background:#f7f5f2;border-radius:32px;box-shadow:0 8px 18px rgba(0,0,0,.1),0 2px 6px rgba(0,0,0,.06);padding:32px;margin:40px auto}
  @media(min-width:990px){.lc__grid{max-width:85%}}
  .lc__media,.lc__col{direction:rtl}
  @media(max-width:889px){.lc__grid{grid-template-columns:1fr;gap:26px;direction:rtl;padding:20px;border-radius:22px}}
  /* Smaller image, no sticky (the earlier sticky made the media hold while
     the rest scrolled, which read as an inside-scroll). */
  .lc__preview{position:relative;border-radius:18px;overflow:hidden;aspect-ratio:1/1;max-width:554px;margin-inline:auto;background:#0d0d16;box-shadow:0 2px 8px rgba(26,26,46,.06),0 20px 50px rgba(26,26,46,.10)}
  .lc__layer{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .9s ease,filter .9s ease}
  .lc__layer--day{opacity:1;z-index:2}
  .lc__layer--night{opacity:0;z-index:1}
  .lc__preview.lit .lc__layer--day{opacity:0}
  .lc__preview.lit .lc__layer--night{opacity:1}
  .lc__preview.single .lc__layer--night{filter:hue-rotate(190deg) saturate(1.35)}
  .lc__preview.multi .lc__layer--night{animation:lc-hue 9s linear infinite}
  @keyframes lc-hue{from{filter:hue-rotate(0deg) saturate(1.3)}to{filter:hue-rotate(360deg) saturate(1.3)}}
  @media(prefers-reduced-motion:reduce){.lc__preview.multi .lc__layer--night{animation:none;filter:hue-rotate(120deg) saturate(1.3)}}
  .lc__pstate{position:absolute;inset-block-end:14px;inset-inline-start:16px;z-index:3;font-size:.72rem;letter-spacing:.12em;color:rgba(255,255,255,.85);opacity:0;transition:opacity .5s}
  .lc__preview.lit .lc__pstate{opacity:1}

  .lc__name{font-size:2rem;font-weight:400;margin:0;letter-spacing:-.015em;line-height:1.1}
  .lc__price{font-size:1.35rem;font-weight:400;margin:7px 0 0;transition:color .2s}
  .lc__price.up{animation:lc-pu .9s ease-in-out}.lc__price.down{animation:lc-pd .9s ease-in-out}
  @keyframes lc-pu{0%,100%{color:var(--ink)}35%,65%{color:var(--up)}}
  @keyframes lc-pd{0%,100%{color:var(--ink)}35%,65%{color:var(--down)}}
  .lc__rule{height:1px;background:var(--line-soft);margin:18px 0}
  .lc__field{margin:0 0 20px}
  .lc__label{font-size:.7rem;font-weight:500;letter-spacing:.16em;color:var(--muted);margin:0 0 10px}
  .lc__note{font-size:.75rem;color:var(--muted);margin:9px 2px 0;line-height:1.55;font-weight:300}
  .lc__pills{display:flex;flex-wrap:wrap;gap:9px}
  .lc__pills--size{flex-wrap:nowrap;gap:7px}
  .lc__pills--size .lc__pill{flex:1 1 0;justify-content:center;padding:9px 6px;font-size:.82rem}
  .lc__pill{display:inline-flex;align-items:center;gap:9px;font-family:inherit;font-size:.88rem;font-weight:400;padding:9px 17px;border-radius:999px;border:1px solid var(--line);background:transparent;color:var(--muted);cursor:pointer;transition:border-color .2s,color .2s,background .2s,transform .1s}
  .lc__pill:hover{border-color:var(--bronze);color:var(--ink)}.lc__pill:active{transform:scale(.98)}
  .lc__pill[aria-pressed=true]{border-color:var(--ink);color:var(--ink);background:#fff}
  .lc__dot{width:13px;height:13px;border-radius:50%;box-shadow:inset 0 0 0 1px rgba(0,0,0,.14)}
  .lc__dot--black{background:#1a1a2e}.lc__dot--white{background:#f4f2ee}.lc__dot--wood{background:linear-gradient(135deg,#c8a06a,#9c6f3f 55%,#7c5326)}
  .lc__noled{display:none;align-items:center;gap:8px;font-size:.77rem;color:var(--muted);margin-top:13px}
  .lc__noled.show{display:flex}.lc__noled b{color:var(--bronze);font-weight:500}
  .lc__custom{margin-top:16px}
  .lc__custom[hidden]{display:none}
  .lc__custom-row{display:flex;align-items:flex-end;gap:12px}
  .lc__custom label{display:flex;flex-direction:column;gap:6px;font-size:.72rem;color:var(--muted);font-weight:400}
  .lc__custom input{width:88px;padding:9px 12px;border:1px solid var(--line);border-radius:10px;font-family:inherit;font-size:.9rem;background:#fff;color:var(--ink)}
  .lc__custom input:focus{outline:none;border-color:var(--bronze)}
  .lc__custom-x{color:var(--muted);padding-bottom:10px}
  .lc__led{border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft)}
  .lc__led-head{width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 2px;background:none;border:0;font-family:inherit;cursor:pointer;text-align:right;color:var(--ink)}
  .lc__led-title{display:flex;align-items:center;gap:10px;font-size:.95rem;font-weight:400}
  .lc__spark{width:12px;height:12px;border-radius:50%;background:radial-gradient(circle at 50% 40%,#ffe6ac,#d99a34 66%,transparent 74%);opacity:.85}
  .lc__led-cur{font-size:.82rem;color:var(--muted);display:flex;align-items:center;gap:9px;font-weight:300}
  .lc__chev{transition:transform .25s;font-size:.64rem;color:var(--muted)}
  .lc__led[open] .lc__chev{transform:rotate(180deg)}
  .lc__led-body{display:grid;grid-template-rows:0fr;transition:grid-template-rows .3s ease}
  .lc__led[open] .lc__led-body{grid-template-rows:1fr}
  .lc__led-inner{overflow:hidden}
  .lc__led-opts{padding:0 0 12px}
  .lc__tier{width:100%;display:flex;align-items:center;gap:13px;padding:11px 10px;border:0;border-radius:12px;background:none;font-family:inherit;cursor:pointer;text-align:right;transition:background .15s}
  .lc__tier:hover{background:#fcfbf9}.lc__tier[aria-pressed=true]{background:var(--bronze-tint)}
  .lc__check{width:14px;flex:0 0 auto;color:var(--bronze);opacity:0;font-size:.8rem}
  .lc__tier[aria-pressed=true] .lc__check{opacity:1}
  .lc__tier-txt{flex:1;min-width:0}
  .lc__tier-txt b{display:block;font-size:.9rem;font-weight:500}
  .lc__tier-txt span{display:block;font-size:.75rem;color:var(--muted);line-height:1.55;font-weight:300}
  .lc__tier-price{font-size:.82rem;font-weight:400;color:var(--bronze);white-space:nowrap}
  .lc__tier-price.free{color:var(--muted);font-weight:300}
  .lc__atc{width:100%;margin-top:20px;background:transparent;color:var(--ink);border:1px solid var(--ink);border-radius:999px;font-family:inherit;font-size:1rem;font-weight:400;padding:16px;cursor:pointer;transition:background .2s,color .2s,transform .1s}
  .lc__atc:hover{background:var(--ink);color:#fff}.lc__atc:active{transform:scale(.99)}
  .lc__desc{margin-top:34px;font-size:.9rem;color:var(--muted);line-height:1.8;font-weight:300;display:-webkit-box;-webkit-line-clamp:4;line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
  .lc__trust{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}
  .lc__trust-item{border:1px solid var(--line);border-radius:12px;padding:12px 8px;text-align:center;font-size:.72rem;color:var(--muted);display:flex;flex-direction:column;align-items:center;gap:7px;line-height:1.4}
  .lc__trust-item svg{width:20px;height:20px;stroke:var(--bronze);stroke-width:1.5;fill:none;stroke-linecap:round;stroke-linejoin:round}
{% endstylesheet %}

<script>
(function(){
  var root=document.currentScript.closest('.lc')||document.querySelector('.lc');
  if(!root)return;
  var data=[];try{data=JSON.parse(root.querySelector('#lc-variants').textContent);}catch(e){}
  var idInput=root.querySelector('#lc-variant-id'),
      colorInput=root.querySelector('#lc-color'),
      priceEl=root.querySelector('#lc-price'),
      preview=root.querySelector('#lc-preview'),
      pstate=root.querySelector('#lc-pstate'),
      led=root.querySelector('#lc-led'),
      ledField=root.querySelector('#lc-ledfield'),
      noled=root.querySelector('#lc-noled'),
      ledCur=root.querySelector('#lc-led-cur'),
      customField=root.querySelector('#lc-custom'),
      dimsInput=root.querySelector('#lc-dims'),
      wIn=root.querySelector('#lc-w'),
      hIn=root.querySelector('#lc-h'),
      form=root.querySelector('#lc-form');
  var SMALL='קטן - 50x50', NONE='ללא תאורה';
  function isCustom(sz){return !!sz && sz.indexOf('התאמה')>-1;}
  function toggleCustom(sz){var c=isCustom(sz);if(!customField)return;customField.hidden=!c;dimsInput.disabled=!c;if(!c){if(wIn)wIn.value='';if(hIn)hIn.value='';dimsInput.value='';}}
  function updateDims(){if(!wIn)return;var w=wIn.value.trim(),h=hIn.value.trim();dimsInput.value=(w&&h)?(w+'x'+h+' ס״מ'):'';wIn.style.borderColor='';hIn.style.borderColor='';}
  if(wIn){wIn.addEventListener('input',updateDims);hIn.addEventListener('input',updateDims);}
  if(form){form.addEventListener('submit',function(e){if(isCustom(size)&&(!wIn.value.trim()||!hIn.value.trim())){e.preventDefault();customField.hidden=false;dimsInput.disabled=false;(wIn.value.trim()?hIn:wIn).focus();wIn.style.borderColor=!wIn.value.trim()?'#d93025':'';hIn.style.borderColor=!hIn.value.trim()?'#d93025':'';}});}
  var size=(root.querySelector('#lc-sizes .lc__pill[aria-pressed=true]')||{}).dataset ? root.querySelector('#lc-sizes .lc__pill[aria-pressed=true]').dataset.size : null;
  var ledVal=NONE, lastPrice=null;

  function find(sz,ld){for(var i=0;i<data.length;i++){if(data[i].size===sz&&data[i].led===ld)return data[i];}return null;}
  function fmt(c){return (c/100).toFixed(2)+' ₪';}
  function priceOf(sz,ld){var v=find(sz,ld);return v?v.price:null;}

  function apply(flash){
    var v=find(size,ledVal);
    if(!v){ // fall back to no-LED for this size (e.g. small)
      ledVal=NONE; v=find(size,NONE);
      root.querySelectorAll('#lc-led-opts .lc__tier').forEach(function(t){t.setAttribute('aria-pressed', t.dataset.led===NONE?'true':'false');});
    }
    if(!v)return;
    idInput.value=v.id;
    if(priceEl){priceEl.textContent=fmt(v.price);
      if(flash&&lastPrice!==null&&v.price!==lastPrice){priceEl.classList.remove('up','down');void priceEl.offsetWidth;priceEl.classList.add(v.price>lastPrice?'up':'down');}
    }
    lastPrice=v.price;
    // preview + led header
    var tier=root.querySelector('#lc-led-opts .lc__tier[data-led="'+cssq(ledVal)+'"]');
    preview.className='lc__preview '+((tier&&tier.dataset.mode)||'');
    var base=priceOf(size,NONE);
    ledCur.textContent = ledVal + (v.price>base? ' · '+(v.price/100).toFixed(0)+' ₪' : '');
    pstate.textContent = ledVal===NONE ? '' : ledVal;
    // per-tier delta labels for the current size
    root.querySelectorAll('#lc-led-opts .lc__tier').forEach(function(t){
      var ld=t.dataset.led, p=priceOf(size,ld), pr=t.querySelector('[data-role=delta]');
      if(!pr)return;
      if(p==null){pr.textContent='';t.style.display='none';return;}
      t.style.display='';
      if(ld===NONE){pr.textContent='כלול';pr.classList.add('free');}
      else{pr.classList.remove('free');pr.textContent='+ '+Math.round((p-base)/100)+' ₪';}
    });
  }
  function cssq(s){return s.replace(/"/g,'\\"');}

  // colors
  root.querySelector('#lc-colors').addEventListener('click',function(e){
    var b=e.target.closest('.lc__pill');if(!b)return;
    this.querySelectorAll('.lc__pill').forEach(function(s){s.setAttribute('aria-pressed','false')});
    b.setAttribute('aria-pressed','true');colorInput.value=b.dataset.color;
  });
  // sizes
  root.querySelector('#lc-sizes').addEventListener('click',function(e){
    var b=e.target.closest('.lc__pill');if(!b)return;
    this.querySelectorAll('.lc__pill').forEach(function(s){s.setAttribute('aria-pressed','false')});
    b.setAttribute('aria-pressed','true');size=b.dataset.size;
    var small=(size===SMALL);
    toggleCustom(size);
    noled.classList.toggle('show',small);
    ledField.style.opacity=small?'.4':'1';ledField.style.pointerEvents=small?'none':'auto';
    if(small){ledVal=NONE;led.removeAttribute('open');
      root.querySelectorAll('#lc-led-opts .lc__tier').forEach(function(t){t.setAttribute('aria-pressed',t.dataset.led===NONE?'true':'false');});}
    apply(true);
  });
  // led toggle + select
  root.querySelector('#lc-led-head').addEventListener('click',function(){led.toggleAttribute('open');});
  root.querySelector('#lc-led-opts').addEventListener('click',function(e){
    var b=e.target.closest('.lc__tier');if(!b)return;
    this.querySelectorAll('.lc__tier').forEach(function(s){s.setAttribute('aria-pressed','false')});
    b.setAttribute('aria-pressed','true');ledVal=b.dataset.led;apply(true);
    setTimeout(function(){led.removeAttribute('open');},340);
  });

  apply(false);
  toggleCustom(size);
})();
</script>

{% schema %}
{
  "name": "LED configurator"
}
{% endschema %}
