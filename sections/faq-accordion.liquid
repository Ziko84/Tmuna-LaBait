<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for i in (1..11) -%}
      {%- assign q_key = 'faq_q' | append: i -%}
      {%- assign a_key = 'faq_a' | append: i -%}
      {%- assign q_text = '' -%}
      {%- assign a_text = '' -%}
      {%- case i -%}
        {%- when 1 -%}{%- assign q_text = faq_q1 -%}{%- assign a_text = faq_a1 -%}
        {%- when 2 -%}{%- assign q_text = faq_q2 -%}{%- assign a_text = faq_a2 -%}
        {%- when 3 -%}{%- assign q_text = faq_q3 -%}{%- assign a_text = faq_a3 -%}
        {%- when 4 -%}{%- assign q_text = faq_q4 -%}{%- assign a_text = faq_a4 -%}
        {%- when 5 -%}{%- assign q_text = faq_q5 -%}{%- assign a_text = faq_a5 -%}
        {%- when 6 -%}{%- assign q_text = faq_q6 -%}{%- assign a_text = faq_a6 -%}
        {%- when 7 -%}{%- assign q_text = faq_q7 -%}{%- assign a_text = faq_a7 -%}
        {%- when 8 -%}{%- assign q_text = faq_q8 -%}{%- assign a_text = faq_a8 -%}
        {%- when 9 -%}{%- assign q_text = faq_q9 -%}{%- assign a_text = faq_a9 -%}
        {%- when 10 -%}{%- assign q_text = faq_q10 -%}{%- assign a_text = faq_a10 -%}
        {%- when 11 -%}{%- assign q_text = faq_q11 -%}{%- assign a_text = faq_a11 -%}
      {%- endcase -%}
      {
        "@type": "Question",
        "name": {{ q_text | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ a_text | json }}
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>

<script>
  (function () {
    document.querySelectorAll('.faq__row').forEach(function (row) {
      var answer = row.querySelector('.faq__row-answer');
      var summary = row.querySelector('.faq__row-summary');

      function setHeight(open) {
        answer.style.maxHeight = open ? answer.scrollHeight + 'px' : '0px';
      }

      setHeight(row.open);

      summary.addEventListener('click', function (event) {
        event.preventDefault();
        var willOpen = !row.open;

        if (willOpen) {
          row.open = true;
          requestAnimationFrame(function () { setHeight(true); });
        } else {
          setHeight(false);
          window.setTimeout(function () { row.open = false; }, 350);
        }
      });
    });
  })();
</script>

{% stylesheet %}
  .faq {
    padding-block: 32px 120px;
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  .faq__intro {
    display: block;
    text-align: center;
    max-width: 38rem;
    margin-inline: auto;
  }

  .faq__eyebrow {
    font-family: var(--font-accent--family);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    color: #1a1a2e;
    opacity: 0.65;
    margin: 0 0 16px;
  }

  .faq__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 1.6rem + 1.6vw, 2.75rem);
    line-height: 1.2;
    color: #1a1a2e;
    margin: 0 0 16px;
  }

  .faq__subtitle {
    font-family: var(--font-body--family);
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / 70%);
    margin: 0;
  }

  .faq__group {
    display: block;
    max-width: 46rem;
    margin-inline: auto;
    width: 100%;
  }

  .faq__group-heading {
    font-family: var(--font-accent--family);
    font-weight: 400;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    color: #1a1a2e;
    opacity: 0.55;
    margin: 0 0 16px;
    padding-inline-start: 4px;
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq__row {
    background-color: #ffffff;
    border: 1px solid rgb(var(--color-foreground-rgb) / 7%);
    border-radius: 16px;
    overflow: hidden;
    transition: border-color 0.25s ease;
  }

  .faq__row[open] {
    border-color: rgb(var(--color-foreground-rgb) / 12%);
  }

  .faq__row-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .faq__row-summary::-webkit-details-marker {
    display: none;
  }

  .faq__row-question {
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 400;
    color: #1a1a2e;
    text-align: right;
  }

  .faq__row-icon {
    flex: none;
    position: relative;
    width: 16px;
    height: 16px;
    opacity: 0.55;
  }

  .faq__row-icon::before,
  .faq__row-icon::after {
    content: '';
    position: absolute;
    background-color: #1a1a2e;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }

  .faq__row-icon::before {
    width: 16px;
    height: 1px;
  }

  .faq__row-icon::after {
    width: 1px;
    height: 16px;
  }

  .faq__row[open] .faq__row-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }

  .faq__row-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq__row-answer p {
    margin: 0;
    padding: 0 24px 22px;
    font-family: var(--font-body--family);
    font-size: 1rem;
    line-height: 1.7;
    color: rgb(var(--color-foreground-rgb) / 75%);
  }

  .faq__link {
    color: #1a1a2e;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .faq {
      gap: 56px;
      padding-block: 24px 80px;
    }

    .faq__row-question {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq reveal-on-scroll.is-observing {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .faq reveal-on-scroll.is-observing.is-revealed {
      opacity: 1;
      transform: translateY(0);
    }
  }
{% endstylesheet %}

