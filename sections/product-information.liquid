

{%- comment -%}
  Shopify's native `structured_data` filter emits a valid ProductGroup but
  omits hasMerchantReturnPolicy and shippingDetails on every offer (flagged
  by Search Console as a "could be improved" item) and gives no per-variant
  description. That filter has no hooks to add them, so this hand-writes
  the same ProductGroup shape instead, matching the richer schema
  led-configurator.liquid already emits for its own product template, with
  real values from the actual shipping/return policy (14-day free return,
  0-day handling, 3-5 business day transit, 45 ILS below 450 ILS / free at
  450 ILS and above).
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "ProductGroup",
  "name": {{ closest.product.title | json }},
  "description": {{ closest.product.description | strip_html | strip_newlines | truncate: 400 | json }},
  "brand": { "@type": "Brand", "name": "תמונה לבית" },
  "productGroupID": {{ closest.product.id | json }},
  "url": {{ closest.product.url | prepend: shop.url | json }},
  "variesBy": ["https://schema.org/size", "https://schema.org/pattern"],
  "image": [
    {%- assign _ld_imgs = closest.product.media | where: 'media_type', 'image' -%}
    {%- for m in _ld_imgs limit: 5 -%}
      {%- capture _u -%}{{ m.preview_image | image_url: width: 1400 }}{%- endcapture -%}
      {%- if _u contains '://' -%}{%- assign _abs = _u -%}{%- else -%}{%- assign _abs = _u | prepend: 'https:' -%}{%- endif -%}
      {{ _abs | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "hasVariant": [
    {%- for v in closest.product.variants -%}
      {%- assign _vimg = v.image | default: closest.product.featured_media.preview_image -%}
      {%- capture _vu -%}{{ _vimg | image_url: width: 1200 }}{%- endcapture -%}
      {%- if _vu contains '://' -%}{%- assign _vabs = _vu -%}{%- else -%}{%- assign _vabs = _vu | prepend: 'https:' -%}{%- endif -%}
      {%- comment -%}
        45 ILS flat shipping below 450 ILS, free at 450 ILS and above (matches
        the Shopify delivery profile's two price-conditioned rates, synced
        the same way to GMC). This JSON-LD always shows the 45 ILS rate since
        schema.org's OfferShippingDetails has no native way to express a
        conditional/tiered rate - a documented simplification, not a bug.
      {%- endcomment -%}
      {%- assign _ship = '45' -%}
      {
        "@type": "Product",
        "name": {{ v.title | prepend: ' - ' | prepend: closest.product.title | json }},
        "description": {{ closest.product.description | strip_html | strip_newlines | truncate: 300 | json }},
        "size": {{ v.option1 | json }},
        "pattern": {{ v.option2 | json }},
        "sku": {{ v.sku | json }},
        "image": {{ _vabs | json }},
        "offers": {
          "@type": "Offer",
          "price": "{{ v.price | divided_by: 100.0 }}",
          "priceCurrency": {{ shop.currency | json }},
          "availability": "https://schema.org/InStock",
          "url": {{ v.url | prepend: shop.url | json }},
          "hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "applicableCountry": "IL",
            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
            "merchantReturnDays": 14,
            "returnMethod": "https://schema.org/ReturnByMail",
            "returnFees": "https://schema.org/FreeReturn"
          },
          "shippingDetails": {
            "@type": "OfferShippingDetails",
            "shippingRate": { "@type": "MonetaryAmount", "value": "{{ _ship }}", "currency": "ILS" },
            "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "IL" },
            {%- comment -%} Matches GMC shipping settings: same business day handling, 3-5 business day transit. {%- endcomment -%}
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 0, "unitCode": "DAY" },
              "transitTime": { "@type": "QuantitativeValue", "minValue": 3, "maxValue": 5, "unitCode": "DAY" }
            }
          }
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>

{% capture media_gallery %}
  {%- content_for 'block',
    type: '_product-media-gallery',
    id: 'media-gallery',
    closest.product: closest.product
  -%}
{% endcapture %}

{% capture product_details %}
  {% content_for 'block',
    type: '_product-details',
    id: 'product-details',
    closest.product: closest.product
  %}
{% endcapture %}

{% capture additional_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% if section.settings.enable_sticky_add_to_cart %}
  {% render 'sticky-add-to-cart' %}
{% endif %}

{% render 'product-information-content',
  product: closest.product,
  section_id: section.id,
  settings: section.settings,
  media_gallery: media_gallery,
  product_details: product_details,
  additional_blocks: additional_blocks
%}

{% render 'product-info-panel', product: closest.product %}

{% comment %} sticky-add-to-cart markup + CSS now lives in snippets/sticky-add-to-cart.liquid, shared with led-configurator.liquid {% endcomment %}

{% schema %}
{
  "name": "t:names.product_information",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_add_to_cart",
      "label": "t:settings.enable_sticky_add_to_cart",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
