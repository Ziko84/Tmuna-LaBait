{%- comment -%}
  Craft strip: three concrete proof points about how each piece is made,
  plus a quiet shipping and returns reassurance line.

  Sits between the product grid and the story section. Deliberately a
  different layout family from the two image-plus-text splits around it,
  so the homepage does not read as the same composition three times.
{%- endcomment -%}

<div
  class="craft-strip"
  style="background-color: {{ section.settings.background_color }}; padding-block: {{ section.settings.padding_block }}px;"
>
  <div class="craft-strip__inner page-width-content">
    {% if section.settings.heading != blank %}
      <h2 class="craft-strip__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <ul class="craft-strip__list list-unstyled">
      {% for block in section.blocks %}
        <li class="craft-strip__item" {{ block.shopify_attributes }}>
          {% if block.settings.value != blank %}
            <span class="craft-strip__value">{{ block.settings.value }}</span>
          {% endif %}
          {% if block.settings.label != blank %}
            <span class="craft-strip__label">{{ block.settings.label }}</span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>

    {% if section.settings.reassurance != blank %}
      <p class="craft-strip__reassurance">{{ section.settings.reassurance }}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .craft-strip__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    text-align: center;
  }

  .craft-strip__heading {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 1.75rem;
    color: #1a1a2e;
    margin: 0;
  }

  /* One connected strip, not three boxed cards: the three claims read as
     facets of a single statement, separated by a hairline rather than each
     wrapped in its own card surface. */
  .craft-strip__list {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .craft-strip__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    flex: 1 1 0;
    padding-inline: 32px;
  }

  .craft-strip__item + .craft-strip__item {
    border-inline-start: 1px solid #ddd7c8;
  }

  /* A short amber rule above the value gives each fact a fixed starting
     point, so values of different lengths still line up optically. Same
     amber as the LED product photography glow (--color-accent-amber, set
     in theme.liquid), so the two are visibly the same color, not just a
     coincidentally similar bronze. */
  .craft-strip__item::before {
    content: '';
    width: 32px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent-amber, #e8a33d);
    margin-block-end: 6px;
  }

  .craft-strip__value {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 1.85rem;
    line-height: 1.15;
    color: #1a1a2e;
  }

  .craft-strip__label {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #5a554d;
    max-width: 30ch;
  }

  /* Set apart from the cards: this line is a promise about the order, not a
     fourth fact about the craft. */
  .craft-strip__reassurance {
    font-size: 0.9rem;
    color: #5a554d;
    margin: 0;
    padding: 10px 20px;
    border: 1px solid #ddd7c8;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.6);
  }

  @media screen and (max-width: 989px) {
    .craft-strip__item {
      padding-inline: 20px;
    }
  }

  @media screen and (max-width: 749px) {
    .craft-strip__inner {
      gap: 28px;
    }

    .craft-strip__list {
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }

    .craft-strip__item {
      width: 100%;
      max-width: 320px;
      padding-inline: 0;
    }

    .craft-strip__item + .craft-strip__item {
      border-inline-start: 0;
      border-block-start: 1px solid #ddd7c8;
      padding-block-start: 24px;
    }

    .craft-strip__value {
      font-size: 1.65rem;
    }

    .craft-strip__reassurance {
      padding: 10px 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Craft strip",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "איך נולדת כל יצירה"
    },
    {
      "type": "text",
      "id": "reassurance",
      "label": "Reassurance line",
      "default": "משלוח תוך 3 עד 5 ימי עסקים. החזרה חינם תוך 14 יום."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f5f2"
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Vertical padding",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Craft strip"
    }
  ]
}
{% endschema %}
