{%- comment -%}
  Craft strip: three concrete proof points about how each piece is made,
  plus a quiet shipping and returns reassurance line.

  Sits between the product grid and the story section. Deliberately a
  different layout family from the two image-plus-text splits around it,
  so the homepage does not read as the same composition three times.
{%- endcomment -%}

<div
  class="craft-strip"
  style="background-color: {{ section.settings.background_color }}; padding-block: {{ section.settings.padding_block }}px;"
>
  <div class="craft-strip__inner page-width-content">
    {% if section.settings.heading != blank %}
      <h2 class="craft-strip__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <ul class="craft-strip__list list-unstyled">
      {% for block in section.blocks %}
        <li class="craft-strip__item" {{ block.shopify_attributes }}>
          {% if block.settings.value != blank %}
            <span class="craft-strip__value">{{ block.settings.value }}</span>
          {% endif %}
          {% if block.settings.label != blank %}
            <span class="craft-strip__label">{{ block.settings.label }}</span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>

    {% if section.settings.reassurance != blank %}
      <p class="craft-strip__reassurance">{{ section.settings.reassurance }}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .craft-strip__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    text-align: center;
  }

  .craft-strip__heading {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 1.75rem;
    color: #1a1a2e;
    margin: 0;
  }

  .craft-strip__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .craft-strip__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .craft-strip__value {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 2rem;
    line-height: 1.1;
    color: #1a1a2e;
  }

  .craft-strip__label {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #5a554d;
  }

  .craft-strip__reassurance {
    font-size: 0.95rem;
    color: #5a554d;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .craft-strip__inner {
      gap: 32px;
    }

    .craft-strip__list {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .craft-strip__value {
      font-size: 1.65rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Craft strip",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "איך נולדת כל יצירה"
    },
    {
      "type": "text",
      "id": "reassurance",
      "label": "Reassurance line",
      "default": "משלוח תוך 2 עד 6 ימי עסקים. החזרה חינם תוך 14 יום."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f5f2"
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Vertical padding",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Craft strip"
    }
  ]
}
{% endschema %}
