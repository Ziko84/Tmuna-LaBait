{%- comment -%}
  Craft strip: three concrete proof points about how each piece is made,
  plus a quiet shipping and returns reassurance line.

  Sits between the product grid and the story section. Deliberately a
  different layout family from the two image-plus-text splits around it,
  so the homepage does not read as the same composition three times.
{%- endcomment -%}

<div
  class="craft-strip"
  style="background-color: {{ section.settings.background_color }}; padding-block: {{ section.settings.padding_block }}px;"
>
  <div class="craft-strip__inner page-width-content">
    {% if section.settings.heading != blank %}
      <h2 class="craft-strip__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <ul class="craft-strip__list list-unstyled">
      {% for block in section.blocks %}
        <li class="craft-strip__item" {{ block.shopify_attributes }}>
          {% if block.settings.value != blank %}
            <span class="craft-strip__value">{{ block.settings.value }}</span>
          {% endif %}
          {% if block.settings.label != blank %}
            <span class="craft-strip__label">{{ block.settings.label }}</span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>

    {% if section.settings.reassurance != blank %}
      <p class="craft-strip__reassurance">{{ section.settings.reassurance }}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .craft-strip__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    text-align: center;
  }

  .craft-strip__heading {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 1.75rem;
    color: #1a1a2e;
    margin: 0;
  }

  .craft-strip__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  /* Each fact is its own card so the three claims read as three distinct
     proof points rather than one run-on paragraph. The card surface, radius
     and hairline match the product cards in the grid directly above, so the
     homepage keeps a single material language. */
  .craft-strip__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 32px 24px 28px;
    background: #ffffff;
    border: 1px solid #ddd7c8;
    border-radius: 16px;
    /* Shadow tinted to the cream background, never pure black. */
    box-shadow: 0 1px 2px rgba(90, 85, 77, 0.05), 0 8px 24px rgba(90, 85, 77, 0.06);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s
      cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* A short bronze rule above the value gives each card a fixed starting
     point, so values of different lengths still line up optically. */
  .craft-strip__item::before {
    content: '';
    width: 32px;
    height: 2px;
    border-radius: 2px;
    background: #8a6e46;
    margin-block-end: 6px;
  }

  .craft-strip__item:hover {
    transform: translateY(-3px);
    box-shadow: 0 2px 4px rgba(90, 85, 77, 0.06), 0 14px 32px rgba(90, 85, 77, 0.1);
  }

  .craft-strip__value {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 1.85rem;
    line-height: 1.15;
    color: #1a1a2e;
  }

  .craft-strip__label {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #5a554d;
    max-width: 30ch;
  }

  /* Set apart from the cards: this line is a promise about the order, not a
     fourth fact about the craft. */
  .craft-strip__reassurance {
    font-size: 0.9rem;
    color: #5a554d;
    margin: 0;
    padding: 10px 20px;
    border: 1px solid #ddd7c8;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    .craft-strip__item {
      transition: none;
    }

    .craft-strip__item:hover {
      transform: none;
    }
  }

  @media screen and (max-width: 989px) {
    .craft-strip__list {
      gap: 16px;
    }

    .craft-strip__item {
      padding: 28px 20px 24px;
    }
  }

  @media screen and (max-width: 749px) {
    .craft-strip__inner {
      gap: 28px;
    }

    .craft-strip__list {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .craft-strip__value {
      font-size: 1.65rem;
    }

    .craft-strip__reassurance {
      padding: 10px 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Craft strip",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "איך נולדת כל יצירה"
    },
    {
      "type": "text",
      "id": "reassurance",
      "label": "Reassurance line",
      "default": "משלוח תוך 2 עד 6 ימי עסקים. החזרה חינם תוך 14 יום."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f5f2"
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Vertical padding",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Craft strip"
    }
  ]
}
{% endschema %}
