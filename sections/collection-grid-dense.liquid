{%- comment -%}
  Dense category grid for the wall-art catalogue: many small square tiles,
  image first, minimal caption, no price/swatches clutter on the grid itself.
  Hover (or tap on touch) reveals the native quick-add trigger - "Add" for a
  single-variant product, "Choose" opening the theme's existing quick-add
  modal for products with more than one option (our size + lighting wall
  art always needs the modal, never a silently-picked default variant).

  Meant to be the "main" section of an alternate collection template
  (see templates/collection.dense-grid.json), assigned per collection from
  the Shopify admin template picker, so the standard collection.json layout
  is untouched for anything that should not use this treatment.

  Also droppable onto any other template (e.g. the homepage) via the
  optional "collection" setting below - when set, it overrides the
  template's own `collection` object, which is blank outside an actual
  collection page.
{%- endcomment -%}

{%- assign the_collection = section.settings.collection | default: collection -%}

<script type="module" src="{{ 'reveal-on-scroll.js' | asset_url }}"></script>

<div class="dense-grid" dir="rtl">
  <div class="section section--page-width dense-grid__wrap">

    {%- if section.settings.show_banner and the_collection.image -%}
      <div class="dense-grid__banner">
        {{
          the_collection.image
          | image_url: width: 1600, quality: 65, format: 'webp'
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            alt: the_collection.image.alt,
            sizes: '100vw',
            widths: '750, 1100, 1500, 1600'
        }}
        <span class="dense-grid__banner-ai-badge">הדמיית AI</span>
      </div>
    {%- endif -%}

    {%- if section.settings.show_content -%}
    <div class="dense-grid__head">
      <h2 class="dense-grid__title">{{ section.settings.heading | default: the_collection.title }}</h2>
      <p class="dense-grid__tagline">אמנות קיר מעץ בחיתוך לייזר. עיצוב ייחודי לכל חלל בבית.</p>
      {%- if the_collection.description != blank -%}
        <p class="dense-grid__desc">{{ the_collection.description }}</p>
      {%- endif -%}
    </div>

    {%- if the_collection.products.size == 0 -%}
      <p class="dense-grid__empty">אין עדיין יצירות בקטגוריה הזו.</p>
    {%- else -%}
      {%- paginate the_collection.products by 250 -%}
      <reveal-on-scroll class="dense-grid__grid">
        {%- for product in the_collection.products -%}
          {%- assign v0 = product.selected_or_first_available_variant -%}
          <div class="dense-grid__tile">
            <a href="{{ product.url }}" class="dense-grid__link" aria-label="{{ product.title | escape }}">
              {%- if product.featured_image -%}
                <img
                  class="dense-grid__img dense-grid__img--primary"
                  src="{{ product.featured_image | image_url: width: 700, quality: 65, format: 'webp' }}"
                  srcset="{{ product.featured_image | image_url: width: 400, quality: 65, format: 'webp' }} 400w,
                          {{ product.featured_image | image_url: width: 700, quality: 65, format: 'webp' }} 700w,
                          {{ product.featured_image | image_url: width: 1000, quality: 65, format: 'webp' }} 1000w"
                  sizes="(min-width: 990px) 220px, 45vw"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="700"
                  height="700"
                >
              {%- else -%}
                <div class="dense-grid__img dense-grid__img--placeholder"></div>
              {%- endif -%}
            </a>

            <div class="dense-grid__cap">
              <a href="{{ product.url }}" class="dense-grid__name">{{ product.title }}</a>
              {%- if v0.price -%}
                <span class="dense-grid__price">מ{{ v0.price | money }}</span>
              {%- endif -%}
            </div>

            <div class="dense-grid__quickadd">
              {% render 'quick-add', product: product, section_id: section.id %}
            </div>
          </div>
        {%- endfor -%}
      </reveal-on-scroll>
      {%- endpaginate -%}
    {%- endif -%}
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
  .dense-grid__wrap {
    padding-block: var(--padding-lg, 32px) var(--padding-2xl, 48px);
  }

  .dense-grid__banner {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 1;
    border-radius: 16px;
    overflow: hidden;
    margin-block-end: clamp(20px, 4vw, 32px);
  }

  .dense-grid__banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .dense-grid__banner-ai-badge {
    position: absolute;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    padding: 4px 12px;
    border-radius: 999px;
    background: rgba(10, 9, 8, 0.55);
    backdrop-filter: blur(2px);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .dense-grid__head {
    text-align: center;
    margin-block-end: var(--padding-lg, 24px);
  }

  .dense-grid__title {
    margin: 0;
  }

  .dense-grid__tagline {
    color: var(--color-foreground-75, rgba(0, 0, 0, 0.65));
    max-width: 60ch;
    margin: 8px auto 0;
  }

  .dense-grid__desc {
    color: var(--color-foreground-75, rgba(0, 0, 0, 0.65));
    max-width: 60ch;
    margin: 8px auto 0;
  }

  .dense-grid__empty {
    text-align: center;
    padding-block: 48px;
    color: var(--color-foreground-75, rgba(0, 0, 0, 0.65));
  }

  .dense-grid__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 3px;
    background: var(--color-border, #e5e0d8);
    border: 1px solid var(--color-border, #e5e0d8);
  }

  @media (min-width: 990px) {
    .dense-grid__grid {
      grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    }
  }

  .dense-grid__tile {
    position: relative;
    background: #0a0908;
    overflow: hidden;
  }

  .dense-grid__link {
    display: block;
    aspect-ratio: 1;
    position: relative;
  }

  .dense-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.45s ease;
  }

  .dense-grid__img--placeholder {
    background: #1a1816;
  }

  .dense-grid__cap {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 9px 11px 8px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72), transparent);
    color: #fff;
    pointer-events: none;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }

  .dense-grid__name {
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    pointer-events: auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dense-grid__price {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.75);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .dense-grid__quickadd {
    position: absolute;
    inset-inline-start: 8px;
    inset-block-start: 8px;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.18s ease, transform 0.18s ease;
    pointer-events: none;
  }

  .dense-grid__tile:hover .dense-grid__quickadd,
  .dense-grid__tile:focus-within .dense-grid__quickadd {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  @media (hover: none) {
    /* touch devices: no hover, always show the quick-add trigger so it is reachable */
    .dense-grid__quickadd {
      opacity: 1;
      transform: none;
      pointer-events: auto;
      inset-inline-start: auto;
      inset-inline-end: 8px;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .dense-grid__img,
    .dense-grid__quickadd {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dense category grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave blank on an actual collection page to use its own products. Required when this section is placed on any other template (e.g. the homepage)."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override",
      "info": "Leave blank to use the collection's own title."
    },
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show banner image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Show heading and product grid",
      "default": true,
      "info": "Turn off to use this section as a standalone banner, e.g. to place the banner separately from the grid on the homepage."
    }
  ],
  "presets": [
    {
      "name": "Dense category grid"
    }
  ]
}
{% endschema %}
