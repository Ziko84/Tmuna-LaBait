{% doc %}
  Homepage "shop by category" as text pills (no images).
  Same 5 collections as the main menu dropdown; pill style matches collection-tabs.
{% enddoc %}

<div class="hcat page-width-content">
  <h2 class="hcat__heading">קנו לפי קטגוריה</h2>
  <nav class="hcat__list" aria-label="קטגוריות">
    <a class="hcat__pill" href="/collections/geometric-animals">חיות גאומטריות</a>
    <a class="hcat__pill" href="/collections/dogs">כלבים</a>
    <a class="hcat__pill" href="/collections/nature-scenes">נופי טבע</a>
    <a class="hcat__pill" href="/collections/living-room-wall-art">תמונות לסלון</a>
    <a class="hcat__pill" href="/collections/bedroom-wall-art">תמונות לחדר שינה</a>
  </nav>
</div>

{% stylesheet %}
  .hcat {
    padding-block: 48px 56px;
    text-align: center;
  }
  .hcat__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.2rem);
    line-height: 1.25;
    color: #1a1a2e;
    margin: 0 0 24px;
  }
  .hcat__list {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    max-width: 1100px;
    margin-inline: auto;
  }
  .hcat__pill {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 120px;
    padding: 24px 16px;
    background: #ffffff;
    border: 1px solid rgb(var(--color-foreground-rgb) / 12%);
    border-radius: 10px;
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    line-height: 1.3;
    color: #1a1a2e;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .hcat__pill:hover {
    background: #1a1a2e;
    border-color: #1a1a2e;
    color: #fff;
  }
  @media screen and (max-width: 749px) {
    .hcat {
      padding-block: 36px 40px;
    }
    .hcat__list {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .hcat__pill {
      min-height: 84px;
      font-size: 1.05rem;
    }
    .hcat__pill:last-child {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category links",
  "settings": [],
  "presets": [{ "name": "Category links" }]
}
{% endschema %}
