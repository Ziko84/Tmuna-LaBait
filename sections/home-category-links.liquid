{% doc %}
  Homepage "shop by category" as text tiles (no images).
  Same 5 collections as the main menu dropdown.
{% enddoc %}

{%- liquid
  assign handles = 'geometric-animals,dogs,nature-scenes,living-room-wall-art,bedroom-wall-art' | split: ','
  assign labels = 'חיות גאומטריות|כלבים|נופי טבע|סלון|חדר שינה' | split: '|'
-%}

<div class="hcat page-width-content">
  <p class="hcat__eyebrow">הקולקציות שלנו</p>
  <h2 class="hcat__heading">קנו לפי קטגוריה</h2>
  <nav class="hcat__list" aria-label="קטגוריות">
    {%- for handle in handles -%}
      {%- assign c = collections[handle] -%}
      <a class="hcat__tile" href="/collections/{{ handle }}">
        <span class="hcat__num">0{{ forloop.index }}</span>
        <span class="hcat__name">{{ labels[forloop.index0] }}</span>
        <span class="hcat__meta">
          {%- if c.products_count > 0 -%}{{ c.products_count }} עיצובים{%- else -%}לצפייה{%- endif -%}
          <span class="hcat__arrow" aria-hidden="true">←</span>
        </span>
      </a>
    {%- endfor -%}
  </nav>
</div>

{% stylesheet %}
  .hcat {
    padding-block: 56px 64px;
    text-align: center;
  }
  .hcat__eyebrow {
    font-family: var(--font-accent--family);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    color: #1a1a2e;
    opacity: 0.6;
    margin: 0 0 10px;
  }
  .hcat__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.2rem);
    line-height: 1.25;
    color: #1a1a2e;
    margin: 0 0 32px;
  }
  .hcat__list {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    max-width: 1200px;
    margin-inline: auto;
  }
  .hcat__tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    text-align: right;
    aspect-ratio: 1 / 1;
    padding: 22px;
    background: #ffffff;
    border: 1px solid rgb(var(--color-foreground-rgb) / 10%);
    border-radius: 16px;
    color: #1a1a2e;
    text-decoration: none;
    box-shadow: 0 1px 2px rgb(26 26 46 / 4%);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease, color 0.25s ease;
  }
  .hcat__num {
    font-family: var(--font-body--family);
    font-size: 0.85rem;
    opacity: 0.4;
  }
  .hcat__name {
    font-family: var(--font-heading--family);
    font-size: clamp(1.1rem, 0.6rem + 0.9vw, 1.5rem);
    line-height: 1.2;
    white-space: nowrap;
  }
  .hcat__meta {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    border-top: 1px solid currentColor;
    border-top-color: rgb(26 26 46 / 12%);
    font-family: var(--font-body--family);
    font-size: 0.85rem;
    opacity: 0.75;
  }
  .hcat__arrow {
    font-size: 1.1rem;
    transition: transform 0.25s ease;
  }
  .hcat__tile:hover {
    transform: translateY(-3px);
    background: #1a1a2e;
    color: #ffffff;
    box-shadow: 0 12px 28px rgb(26 26 46 / 18%);
  }
  .hcat__tile:hover .hcat__meta {
    border-top-color: rgb(255 255 255 / 25%);
  }
  .hcat__tile:hover .hcat__arrow {
    transform: translateX(-4px);
  }
  @media screen and (max-width: 989px) {
    .hcat__name { font-size: 1.25rem; }
  }
  @media screen and (max-width: 749px) {
    .hcat {
      padding-block: 40px 44px;
    }
    .hcat__list {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .hcat__tile {
      aspect-ratio: auto;
      min-height: 132px;
      padding: 16px;
      border-radius: 14px;
    }
    .hcat__name { font-size: 1.15rem; }
    .hcat__tile:last-child {
      grid-column: 1 / -1;
      min-height: 100px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category links",
  "settings": [],
  "presets": [{ "name": "Category links" }]
}
{% endschema %}
