{%- comment -%}
  Starts from Shopify's own robots rules so the platform's crawl-budget
  protections (checkout, cart, account, search noise) stay intact, then
  explicitly allows the AI crawlers. Without an explicit allow these agents
  fall back to whatever they infer, and several treat "unlisted" as
  "unavailable".
{%- endcomment -%}
{%- for group in robots.default_groups -%}
  {{- group.user_agent -}}
  {%- for rule in group.rules -%}
    {{ rule }}
  {%- endfor -%}
  {%- if group.sitemap -%}
    {{ group.sitemap }}
  {%- endif -%}
{%- endfor -%}

