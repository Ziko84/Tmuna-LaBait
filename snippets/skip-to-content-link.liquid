{%- doc -%}
  Renders a skip to content link, visible on focus only.
  Parent element must have position: relative to ensure proper positioning.

  @param {string} href - The URL to skip to, usually an id like "#MainContent".
  @param {string} text - The text to display, in the form of a translation key for a locale file.

  @example
  {% render 'skip-to-content-link', href: '#MainContent', text: 'Skip to main content' %}
{%- enddoc -%}

<a
  class="skip-to-content-link button-secondary"
  href="{{ href }}"
>
  {{ text | t }}
</a>

{% stylesheet %}
  /* Visually hidden without moving off-screen - an element parked
     thousands of pixels away (the old left: -99999px) can make some
     mobile browsers miscalculate the page's real layout width and
     render the whole site zoomed out to fit it. This keeps the link in
     its normal position but invisible until focused, which can never
     inflate the page's width. */
  .skip-to-content-link {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .skip-to-content-link:focus {
    z-index: var(--layer-temporary);
    width: auto;
    height: auto;
    margin: 0;
    overflow: auto;
    clip: auto;
    white-space: normal;
    padding: var(--padding-lg) var(--padding-4xl);
    left: var(--margin-lg);
    top: var(--margin-lg);
    background-color: var(--color-background);
    box-shadow: 0 0 0 var(--focus-outline-offset) var(--color-background);
  }
{% endstylesheet %}
