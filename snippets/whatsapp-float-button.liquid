{%- doc -%}
  Sitewide floating WhatsApp contact button, fixed to the bottom-left corner
  regardless of the page's RTL text direction (explicit user request, not a
  layout-direction bug). Uses the same verified number already linked on the
  Contact page and the homepage's WhatsApp CTA.
{%- enddoc -%}

<a
  href="https://wa.me/972546385242"
  class="whatsapp-float-button"
  target="_blank"
  rel="noopener"
  aria-label="{{ 'accessibility.whatsapp_contact' | t: default: 'צרו קשר בוואטסאפ' }}"
>
  <span class="svg-wrapper whatsapp-float-button__icon" aria-hidden="true">
    {{- 'icon-whatsapp.svg' | inline_asset_content -}}
  </span>
</a>

{% stylesheet %}
  .whatsapp-float-button {
    position: fixed;
    inset-block-end: 20px;
    left: 20px;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: #25d366;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .whatsapp-float-button:hover {
    transform: scale(1.06);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28);
  }

  .whatsapp-float-button__icon {
    width: 30px;
    height: 30px;
    display: block;
  }

  .whatsapp-float-button__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .whatsapp-float-button {
      width: 50px;
      height: 50px;
      /* Product pages render a full-width sticky-add-to-cart bar pinned to
         the screen bottom on mobile (see sticky-add-to-cart.liquid) - this
         clears its height so the button never sits behind it, on product
         pages or anywhere else. */
      inset-block-end: 88px;
      left: 16px;
    }

    .whatsapp-float-button__icon {
      width: 26px;
      height: 26px;
    }
  }
{% endstylesheet %}
