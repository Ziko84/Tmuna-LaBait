{%- doc -%}
  Hover crossfade for the homepage banners: swaps the day shot for a
  pixel-aligned night version (lights off / LED glow on) on hover.
  Maps a section id suffix to a theme asset filename below - add a new
  entry to cover another banner.

  Every banner listed in nightImages also gets the LED color swatches,
  bottom-left, same as product images - since their night image is a
  static theme asset rather than product media, the mask/swatches
  markup is injected here in JS instead of via Liquid. Exception:
  hero_overlay_LfPdEJ (the bottom homepage banner) - swatches
  removed there per request, so it keeps just the day/night hover
  crossfade with no color picker.

  @example
  {% render 'hero-night-mode' %}
{%- enddoc -%}

<script>
  (function () {
    var nightImageBaseUrls = {
    '__hero_split_tlb01': {{ 'hero-night.png' | asset_url | json }},
    '__hero_overlay_LfPdEJ': {{ 'banner-night.png' | asset_url | json }}
    };

    // Pick from a small fixed set of CDN-cacheable widths based on the
    // container's actual rendered size, instead of always requesting a
    // fixed 1000px image regardless of viewport (was flagged by PageSpeed
    // as ~19 KiB oversized on narrower/mobile layouts).
    var availableWidths = [400, 600, 800, 1000, 1600];
    function widthForContainer(container) {
      var target = Math.ceil((container.offsetWidth || 800) * (window.devicePixelRatio || 1));
      for (var i = 0; i < availableWidths.length; i++) {
        if (availableWidths[i] >= target) return availableWidths[i];
      }
      return availableWidths[availableWidths.length - 1];
    }
    var ledColors = [
      { color: '', label: 'לבן חם', active: true, gradient: true },
      { color: '#00b0ff', label: 'כחול' },
      { color: '#ff5722', label: 'אדום' },
      { color: '#64dd17', label: 'ירוק' },
      { color: '#e91e63', label: 'ורוד' }
    ];

    function addLedSwatches(container, nightImageUrl) {
      if (container.querySelector('.led-swatches')) return;

      var tint = document.createElement('div');
      tint.className = 'led-tint';
      tint.style.setProperty('--led-mask-url', 'url(' + nightImageUrl + ')');
      container.appendChild(tint);

      var ul = document.createElement('ul');
      ul.className = 'led-swatches';
      ul.setAttribute('aria-label', 'בחר צבע תאורה');

      ledColors.forEach(function (entry) {
        var li = document.createElement('li');
        var button = document.createElement('button');
        button.type = 'button';
        button.className = 'led-swatch' + (entry.active ? ' led-swatch--active' : '');
        button.dataset.ledColor = entry.color;
        button.setAttribute('aria-pressed', entry.active ? 'true' : 'false');
        button.setAttribute('aria-label', entry.label);
        // Empty on:click makes the theme's own component framework treat
        // this button as its own resolved click target instead of
        // bubbling up via closest() to whatever on:click a wrapping
        // container (e.g. a zoom-dialog trigger) might carry.
        button.setAttribute('on:click', '');
        button.style.background = entry.gradient
          ? 'linear-gradient(135deg, #fff3d6, #ffb347)'
          : entry.color;
        li.appendChild(button);
        ul.appendChild(li);
      });

      container.appendChild(ul);
    }

    function initBannerNightMode() {
      Object.keys(nightImageBaseUrls).forEach(function (suffix) {
        var container = document.querySelector('[id$="' + suffix + '"] .media-block');
        if (!container || container.querySelector('.hero-night-image')) return;
        var nightImageUrl = nightImageBaseUrls[suffix] + '&width=' + widthForContainer(container);
        var img = document.createElement('img');
        img.className = 'hero-night-image';
        img.src = nightImageUrl;
        img.alt = '';
        img.loading = 'lazy';
        // Matches the day image's own width/height attributes (Shopify sets
        // these server-side, so they're present immediately - naturalWidth/
        // Height would need the day image to have already finished loading,
        // which isn't guaranteed this early). Position: absolute means this
        // image can't cause layout shift either way, but this keeps the
        // markup complete rather than leaving width/height unset.
        var dayImage = container.querySelector('.media-block__media');
        if (dayImage && dayImage.getAttribute('width') && dayImage.getAttribute('height')) {
          img.width = dayImage.getAttribute('width');
          img.height = dayImage.getAttribute('height');
        }
        container.appendChild(img);
        if (suffix !== '__hero_overlay_LfPdEJ') {
          addLedSwatches(container, nightImageUrl);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBannerNightMode);
    } else {
      initBannerNightMode();
    }
  })();
</script>
