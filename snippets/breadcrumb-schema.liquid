{%- doc -%}
  Emits BreadcrumbList JSON-LD with absolute item URLs.
  Guards on page type so it only renders on the matching template:
    - collection pages: Home > collection.title
    - product pages:    Home > (first collection if any) > product.title
{%- enddoc -%}
{%- liquid
  assign home_name = 'דף הבית'
-%}
{%- if request.page_type == 'collection' and collection != blank -%}
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": {{ home_name | json }},
      "item": {{ shop.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": {{ shop.url | append: collection.url | json }}
    }
  ]
}
  </script>
{%- elsif request.page_type == 'product' and product != blank -%}
  {%- assign first_collection = product.collections.first -%}
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": {{ home_name | json }},
      "item": {{ shop.url | json }}
    }{% if first_collection != blank %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ first_collection.title | json }},
      "item": {{ shop.url | append: first_collection.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ product.title | json }},
      "item": {{ shop.url | append: product.url | json }}
    }{% else %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.title | json }},
      "item": {{ shop.url | append: product.url | json }}
    }{% endif %}
  ]
}
  </script>
{%- endif -%}
