{%- doc -%}
  Floating bottom navigation (Home / Shop / Blog / Contact) with a
  "rolling ball" indicator that pops the active item's icon up above the
  bar, echoing a bump-nav reference design. The 4 items are always real,
  crawlable <a> links - the ball is a decorative, aria-hidden overlay
  driven by --notch-x (a plain percentage custom property), so the bar
  still works with no JS, just without the hover roll.
{%- enddoc -%}

{%- liquid
  assign active_index = 0
  if request.page_type == 'index'
    assign active_index = 0
  elsif request.page_type == 'collection' or request.page_type == 'product' or request.page_type == 'search' or request.page_type == 'list-collections'
    assign active_index = 1
  elsif request.page_type == 'blog' or request.page_type == 'article'
    assign active_index = 2
  elsif request.page_type == 'page' and page.handle == 'contact'
    assign active_index = 3
  endif

  assign notch_positions = '12.5,37.5,62.5,87.5' | split: ','
  assign notch_x = notch_positions[active_index]
-%}

{%- capture icon_home -%}
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.47 3.84a.75.75 0 0 1 1.06 0l8.69 8.69a.75.75 0 1 0 1.06-1.06l-8.689-8.69a2.25 2.25 0 0 0-3.182 0l-8.69 8.69a.75.75 0 1 0 1.061 1.06l8.69-8.69Z"/><path d="M12 5.432 20.159 13.591c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 0 1-.75-.75v-4.5a.75.75 0 0 0-.75-.75h-3a.75.75 0 0 0-.75.75V21a.75.75 0 0 1-.75.75H5.625a1.875 1.875 0 0 1-1.875-1.875v-6.198a2.29 2.29 0 0 0 .091-.086L12 5.43Z"/></svg>
{%- endcapture -%}

