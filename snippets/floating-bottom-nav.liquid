{%- doc -%}
  Floating nav bar (Home / Shop / Blog / Contact), positioned under the
  header, with a sliding pill highlight behind the active/hovered word.
  Pill position and width are measured live from the DOM via JS
  (getBoundingClientRect), not hardcoded percentages - the site is RTL,
  and a fixed left-to-right percentage table doesn't line up with where
  items actually render in RTL layout.
{%- enddoc -%}

{%- liquid
  assign active_index = 0
  if request.page_type == 'index'
    assign active_index = 0
  elsif request.page_type == 'collection' or request.page_type == 'product' or request.page_type == 'search' or request.page_type == 'list-collections'
    assign active_index = 1
  elsif request.page_type == 'blog' or request.page_type == 'article'
    assign active_index = 2
  elsif request.page_type == 'page' and page.handle == 'contact'
    assign active_index = 3
  endif
-%}

<nav
  class="floating-bottom-nav"
  aria-label="{{ 'accessibility.header_navigation_label' | t }}"
  data-floating-bottom-nav
  data-active-index="{{ active_index }}"
>
  <div class="floating-bottom-nav__bar">
    <div class="floating-bottom-nav__pill" aria-hidden="true"></div>
    <a
      href="/"
      class="floating-bottom-nav__item{% if active_index == 0 %} is-active{% endif %}"
      {% if active_index == 0 %}aria-current="page"{% endif %}
    >בית</a>
    <a
      href="/collections/frontpage"
      class="floating-bottom-nav__item{% if active_index == 1 %} is-active{% endif %}"
      {% if active_index == 1 %}aria-current="page"{% endif %}
    >חנות</a>
    <a
      href="/blogs/news"
      class="floating-bottom-nav__item{% if active_index == 2 %} is-active{% endif %}"
      {% if active_index == 2 %}aria-current="page"{% endif %}
    >בלוג</a>
    <a
      href="/pages/contact"
      class="floating-bottom-nav__item{% if active_index == 3 %} is-active{% endif %}"
      {% if active_index == 3 %}aria-current="page"{% endif %}
    >צרו קשר</a>
  </div>
</nav>

<script>
  (function () {
    var nav = document.querySelector('[data-floating-bottom-nav]');
    if (!nav) return;

    var bar = nav.querySelector('.floating-bottom-nav__bar');
    var pill = nav.querySelector('.floating-bottom-nav__pill');
    var items = Array.prototype.slice.call(nav.querySelectorAll('.floating-bottom-nav__item'));
    var activeIndex = parseInt(nav.dataset.activeIndex, 10) || 0;

    function movePillTo(index) {
      var item = items[index];
      if (!item) return;
      var barRect = bar.getBoundingClientRect();
      var itemRect = item.getBoundingClientRect();
      pill.style.left = (itemRect.left - barRect.left) + 'px';
      pill.style.width = itemRect.width + 'px';
      pill.style.opacity = '1';
      items.forEach(function (it, i) {
        it.classList.toggle('is-active', i === index);
      });
    }

    function resetToActive() {
      movePillTo(activeIndex);
    }

    requestAnimationFrame(resetToActive);
    window.addEventListener('resize', resetToActive);

    items.forEach(function (item, index) {
      item.addEventListener('pointerenter', function (event) {
        if (event.pointerType === 'mouse') movePillTo(index);
      });
      item.addEventListener('focus', function () {
        movePillTo(index);
      });
    });

    nav.addEventListener('pointerleave', function (event) {
      if (event.pointerType === 'mouse') resetToActive();
    });
    nav.addEventListener('focusout', function (event) {
      if (!nav.contains(event.relatedTarget)) resetToActive();
    });
  })();
</script>
{%- comment -%}
  Styling for this component lives in layout/theme.liquid's <style> block,
  not here - a <style> tag placed inside a rendered snippet gets silently
  stripped from the final page output (confirmed by diffing the live HTML),
  while one written directly in theme.liquid survives. Search
  ".floating-bottom-nav" there.
{%- endcomment -%}
