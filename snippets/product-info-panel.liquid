{%- comment -%}
  Product information panel.

  Rendered from sections/product-information.liquid rather than added to
  templates/product.json as a section: Shopify's GitHub sync stopped applying
  changes to that JSON template (its live copy is pinned to an older version
  while every Liquid file in the same pushes deploys normally), so the content
  has to arrive through a Liquid file to reach the store at all.

  These three bodies of text used to be accordions inside the buy column,
  where they competed with the price and the add to cart button for the same
  narrow strip, and pushed the button down the page every time one opened.
  Here they sit full width below the card, open, at a readable measure.

  The description still appears in the buy column as a short summary, so the
  card above continues to say what the product actually is.
{%- endcomment -%}

{%- assign panel_product = product -%}
{%- assign details_text = 'היצירה נחתכת בלייזר בדיוק של שבריר מילימטר, מעץ בוטיק איכותי, ומוארת באור רך מבפנים. כל פרט מתוכנן בקפידה כדי להשתלב בבית שלכם.' -%}

<div
  class="product-info-panel"
  style="background-color: #f7f5f2; padding-block: 64px;"
>
  <div class="product-info-panel__inner page-width-content">
    {% if true %}
      <h2 class="product-info-panel__heading">כל מה שכדאי לדעת</h2>
    {% endif %}

    <div class="product-info-panel__columns">
      {% if panel_product.description != blank %}
        <div class="product-info-panel__column">
          <h3 class="product-info-panel__column-heading">תיאור</h3>
          <div class="product-info-panel__body rte">{{ panel_product.description }}</div>
        </div>
      {% endif %}

      {% if true %}
        <div class="product-info-panel__column">
          <h3 class="product-info-panel__column-heading">פרטים נוספים</h3>
          <div class="product-info-panel__body rte">{{ details_text }}</div>
        </div>
      {% endif %}

      {% if true %}
        <div class="product-info-panel__column">
          <h3 class="product-info-panel__column-heading">משלוחים והחזרות</h3>
          <div class="product-info-panel__body rte"><p>ההזמנה יוצאת אליכם תוך 1 עד 3 ימי עסקים ומגיעה תוך 2 עד 6 ימי עסקים מרגע ההזמנה.</p><p>חשוב לנו שתהיו מרוצים מהרכישה. ניתן להחזיר פריט תוך 14 ימים ממועד הקבלה, ומשלוח ההחזרה הוא על חשבוננו. פנו אלינו דרך עמוד צרו קשר ונטפל בבקשה בקפידה ובהתחשבות.</p></div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% style %}
  .product-info-panel__inner {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .product-info-panel__heading {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 1.5rem;
    color: #1a1a2e;
    margin: 0;
    text-align: center;
  }

  .product-info-panel__columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    align-items: start;
  }

  .product-info-panel__column-heading {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 1.05rem;
    color: #1a1a2e;
    margin: 0 0 12px;
    padding-block-end: 12px;
    border-block-end: 1px solid rgba(26, 26, 46, 0.12);
  }

  .product-info-panel__body {
    font-size: 0.95rem;
    line-height: 1.75;
    color: #5a554d;
  }

  .product-info-panel__body p {
    margin: 0 0 12px;
  }

  .product-info-panel__body p:last-child {
    margin-block-end: 0;
  }

  @media screen and (max-width: 989px) {
    .product-info-panel__columns {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .product-info-panel__inner {
      gap: 28px;
    }
  }
{% endstyle %}
