{%- liquid
  assign preloaded_font_urls = '' | split: ','
  for font in settings.type_body_font, settings.type_subheading_font, settings.type_heading_font, settings.type_accent_font
    if font.system?
      continue
    endif
    assign font_url_value = font | font_url
    if preloaded_font_urls contains font_url_value
      continue
    endif
    assign preloaded_font_urls = preloaded_font_urls | push: font_url_value
    echo font_url_value | preload_tag: as: 'font', type: 'font/woff2', fetchpriority: 'low'
  endfor
-%}
