{%- comment -%}
  Review stars for product cards. Rendered from blocks/product-title.liquid so
  it lands inside the title and price group, directly under the title. It used
  to be appended by the gallery block and moved into place with JS, which put
  it below the price whenever the script did not land.

  Real data when it exists (Judge.me syncs into the reviews.rating metafield),
  a quiet empty state when it does not, so a card never claims a rating it has
  not earned.
{%- endcomment -%}
{%- liquid
  assign card_rating = card_product.metafields.reviews.rating.value.rating
  assign card_rating_count = card_product.metafields.reviews.rating_count | default: 0
  assign card_filled = card_rating | default: 0 | round
-%}
<div class="product-card__stars{% if card_rating_count == 0 %} product-card__stars--empty{% endif %}">
  <span class="product-card__stars-icons" aria-hidden="true">
    {%- for star in (1..5) -%}
      <svg viewBox="0 0 32 32" class="product-card__star{% if star <= card_filled %} is-filled{% endif %}" role="presentation">
        <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z"/>
      </svg>
    {%- endfor -%}
  </span>
  <span class="product-card__stars-count">
    {%- if card_rating_count == 0 -%}
      0 ביקורות
    {%- else -%}
      {{ card_rating_count }} ביקורות
    {%- endif -%}
  </span>
</div>
